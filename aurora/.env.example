# Copy to .env and fill in the credential. Everything here is an operator
# setting: the file is read by compose on the host and never lands in a
# container, so no agent can read it, and neither can the model they talk to.

# --- the model -------------------------------------------------------------
# The recorder holds this and injects it. It is the one credential in the
# world, and it exists in exactly one container's environment.
OPENROUTER_API_KEY=
# Or point at any OpenAI-compatible endpoint instead:
#LLM_BASE_URL=http://host.docker.internal:11434/v1
#LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-pro

# Per-agent override, if you want the fleet to be heterogeneous. HOST1..HOST10
# fall back to LLM_MODEL when unset. Being given different models is a fact
# about the fleet, not a rank; the agents are not told which they got.
#HOST2_LLM_MODEL=deepseek/deepseek-v4-pro

# --- the conversation window ----------------------------------------------
# The newest messages that fit are sent; the system prompt and the first user
# message always are. What falls out is not summarised: an agent's `compact`
# tool reports how full the window is, and remembering more is the agent's to
# build. Bigger windows cost more per turn. HOST1..HOST10 may override it, as
# HOST2_CONTEXT_WINDOW_TOKENS.
# The window counts messages only. It, plus the tool schemas (about 1,300 tokens
# in the seed), plus the model's reply, with a margin for the chars/4 estimate,
# must fit the model's context; past it the request is refused and the agent
# starts again with a fresh conversation. The default model, deepseek-v4-pro,
# has about 1,024,000 tokens of context and replies of up to 384,000, which the
# default leaves room for (tests/test_window_headroom.py). A host given a
# smaller model needs a smaller window: deepseek-v3.2's context is 163,840.
CONTEXT_WINDOW_TOKENS=200000
# Eviction moves in chunks of this size so the window's start holds still and
# consecutive requests share a long prefix. Defaults to an eighth of the window.
#CONTEXT_WINDOW_EVICTION_TOKENS=25000

# --- bounded volumes ------------------------------------------------------
# Every volume an agent or a recorder writes is a preallocated ext4 image,
# loop-mounted under SPACE_VOLUMES_DIR, so a full disk is one image's problem and
# never the host's or the record's. scripts/prepare_host.sh plans and creates
# them; mounting needs root and the script prints exactly what to run. The image
# files live in SPACE_VOLUME_IMG_DIR, beside volumes/ rather than inside it.
# By default each agent's images are 12.625G and the shared ones 11.0625G,
# so the total is 137.3125G for ten agents.
# Each size is a whole number then K, M, G or T. Images grow but never shrink.
#SPACE_VOLUMES_DIR=./volumes
#SPACE_VOLUME_IMG_DIR=./volume-images
#SPACE_VOLUME_WARN_PERCENT=80
# per agent
#SPACE_STATE_SIZE=2G
#SPACE_PUMP_SIZE=512M
#SPACE_BUILD_SIZE=4G
#SPACE_TELEMETRY_SIZE=2G
#SPACE_TRANSCRIPTS_SIZE=4G
#SPACE_LLM_SOCK_SIZE=64M
#SPACE_LLM_CONSOLE_SIZE=64M
# shared
#SPACE_SHARED_SIZE=8G
#SPACE_DIODE_SIZE=2G
#SPACE_FLEET_LEDGER_SIZE=64M
#SPACE_OPERATOR_TELEMETRY_SIZE=1G

# --- declared streams -----------------------------------------------------
# An agent can declare extra model sockets in its /llm/console/console.json,
# each with its own hourly budget, served by its own recorder and counted on
# the fleet ledger. They are off until a model is allowed here: with both lists
# empty every declaration is refused as "model not permitted". The console seed
# each agent starts from is generated from these lists by prepare_host.sh.
STREAM_MODEL_ALLOW_TEXT=
STREAM_MODEL_ALLOW_VISION=
# Per-stream hourly ceilings; empty means the recorder's own (120 requests,
# 2,000,000 tokens).
STREAM_HOURLY_MAX=
STREAM_TOKEN_HOURLY_MAX=

# --- the recorder's ceilings, in its environment and nowhere else ----------
# Requests and tokens per agent per hour, and one token pool over the whole
# fleet over a rolling hour. A fleet of ten multiplies per-agent allowances by
# ten; the global pool is what does not scale.
# Requests are a rate guard; tokens are the spend guard. Both must be set
# against a real conversation rather than a toy one: a fleet that keeps its
# whole history sends it again on every turn, so a few hundred turns is already
# hundreds of millions of tokens. The defaults are deliberately loose, because a
# rate limit that fires during ordinary work teaches the fleet that the world is
# unreliable rather than that it is bounded.
RECORDER_HOURLY_MAX=2400
RECORDER_TOKEN_HOURLY_MAX=200000000
RECORDER_TOKEN_GLOBAL_HOURLY_MAX=2000000000

# --- what each recorder accepts, how long it waits, and what it records ----
# A request body is at most REQUEST_MAX_BYTES and must be one strict JSON object
# (no repeated key, no NaN, no overflowing number, no lone surrogate), within
# a structure bound of depth 64, 32768 containers and 131072 values; a buffered
# reply is at most RESPONSE_MAX_BYTES.
REQUEST_MAX_BYTES=16777216
RESPONSE_MAX_BYTES=16777216
# Every request's clock starts when the recorder takes it. Its upstream phase
# ends at RECORDER_UPSTREAM_DEADLINE seconds however late it began, nothing is
# sent after RECORDER_LATEST_START, and every socket operation is bounded by
# RECORDER_OPERATION_TIMEOUT. The upstream deadline must end inside the agent
# client's own timeout less the margin; the recorder refuses to start otherwise.
RECORDER_CLIENT_TIMEOUT=600
RECORDER_DEADLINE_MARGIN=30
RECORDER_UPSTREAM_DEADLINE=540
RECORDER_LATEST_START=480
RECORDER_OPERATION_TIMEOUT=60
# Every buffered reply an agent acts on is written to its transcript, and synced,
# before it is relayed; a reply that cannot be recorded is withheld (502) and
# still charged. Below this much free space on the transcript volume, requests
# are refused before they are paid for (503 record_capacity).
RECORDER_MIN_FREE_BYTES=134217728

# --- the fleet's size, on one machine -------------------------------------
# Three gigabytes and one CPU each, times ten plus the operator services. Fit
# these to the host before adding agents; a fleet that has been starved looks
# exactly like a fleet that has been lazy.
AGENT_MEM=3g
AGENT_CPUS=1.0
#PUMP_MAX_ENTRIES=32
#PUMP_MAX_CONCURRENT=8

# --- the window outward ----------------------------------------------------
# The diode's own ceilings. Its module owns its verbs; these are the operator's
# limits on how much of anything it will do in an hour.
#DIODE_HOURLY_MAX=120
#DIODE_POLL_SECONDS=5

# --- the review panel ------------------------------------------------------
# A read-only window an operator can look through: each agent's conversation,
# its reasoning, every tool call with the result that came back, and the
# monitor's view of its liveness and spend. It opens the record and cannot
# change it.
#
# It binds host loopback only. It reads everything an agent thought; that should
# not turn up on a network by accident.
#REVIEW_PORT=8090
#REVIEW_BIND=127.0.0.1
# How much of each transcript's tail is parsed to serve a page. A turn is a few
# hundred kilobytes, so the default window is a hundred turns or so.
#REVIEW_MAX_BYTES=33554432
#REVIEW_DEFAULT_TURNS=25

# --- time ------------------------------------------------------------------
# How often the fleet monitor republishes what the transcripts say. (A run that
# makes no progress for 24 hours is the watchdog's to end; that figure is in the
# agent's own watchdog.py, and the agent's to change.)
#MONITOR_INTERVAL_SECONDS=15
