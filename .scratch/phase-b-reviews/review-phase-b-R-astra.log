   395	    def enforced_caps(self) -> dict[str, tuple[float, int, int | None]]:
   396	        """What the kernel enforces on each running service: its container's own cgroup (v2), read
   397	        from the host side, so nothing inside the container is trusted or needs to answer."""
   398	        caps = {}
   399	        for service in self.services():
   400	            short = self.container_id(service)
