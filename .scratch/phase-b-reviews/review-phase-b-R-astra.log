   365	    def recreate(self, service: str, environment: dict[str, str]) -> None:
   366	        """Recreate one running service alone, with its environment changed and nothing else."""
   367	        path = self.root / f"recreate-{service}.yml"
   368	        lines = ["services:", f"  {service}:", "    environment:"]
   369	        # JSON's string is a YAML double-quoted scalar; `$$` is compose's literal dollar.
   370	        lines += [
   371	            f"      {key}: {json.dumps(str(value).replace('$', '$$'))}"
   372	            for key, value in environment.items()
