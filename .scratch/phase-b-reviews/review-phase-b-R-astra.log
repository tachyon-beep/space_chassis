   100	def _files(window) -> set:
   101	    """Every regular file under a window now. A directory listed and gone before it is walked is
   102	    listed again, so a walk the vehicle races ends in a listing, never an error."""
   103	    for attempt in range(5):
   104	        try:
   105	            return {p for p in window.rglob("*") if p.is_file()}
   106	        except FileNotFoundError:
   107	            if attempt == 4:
   108	                raise
   109	            time.sleep(0.1)
   110	    raise AssertionError("unreachable")
