   408	    def _hold_the_lock(self) -> None:
   409	        fd = os.open(self.lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
   410	        try:
   411	            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
