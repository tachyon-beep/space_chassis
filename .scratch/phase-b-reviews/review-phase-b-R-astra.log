   379	    def others_running(self) -> list[str]:
   380	        """Every other smoke project with a container up on this daemon."""
   381	        label = "com.docker.compose.project"
   382	        template = f'{{{{.Label "{label}"}}}}'
   383	        result = self.run(["docker", "ps", "--filter", f"label={label}", "--format", template])
