   402	            full = self.run(["docker", "inspect", "-f", "{{.Id}}", short]).stdout.strip()
   403	            scope = DOCKER_CGROUPS / f"docker-{full}.scope"
   404	            assert scope.is_dir(), f"{service}'s cgroup is not at {scope}"
   405	            caps[service] = cgroup_limits(scope)
