   339	    def build(self) -> None:
   340	        kept = CONSOLE_SEED.read_bytes() if CONSOLE_SEED.exists() else None
   341	        try:
   342	            self.run(
   343	                [
   344	                    sys.executable,
   345	                    str(REPO / "scripts" / "build_console_seed.py"),
   346	                    "--source",
   347	                    ".env.example",
   348	                ]
   349	            )
   350	            # The vehicle is in its own profile and image: built only by name, and only when it
   351	            # serves. One build at a time (Governance, 2026-10-11): compose builds the services it
   352	            # is given in parallel, so each is its own call.
   353	            self.compose("build", "agent_1", timeout=BUILD_TIMEOUT_SECONDS)
   354	            if self.window == "vehicle":
