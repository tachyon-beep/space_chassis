   413	            os.close(fd)
   414	            raise RuntimeError(f"one smoke stack at a time: another holds {self.lock}") from None
   415	        self._lock_fd = fd
   416	
   417	    def _release_the_lock(self) -> None:
   418	        if self._lock_fd is not None:
   419	            os.close(self._lock_fd)
   420	            self._lock_fd = None
   421	
   422	    def _refuse_beside_another(self) -> None:
   423	        others = self.others_running()
   424	        if others:
   425	            raise RuntimeError(f"one smoke stack at a time: {', '.join(others)} is running")
