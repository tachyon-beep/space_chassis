   113	# How often a scan of one window lists it again after a file it listed is gone. A cycle every
   114	# 0.2 s removes a few names (the temporaries it renames into place, the telemetry it prunes); one
   115	# window's scan takes milliseconds, so a scan that needs more than this is not racing a cycle.
   116	RELISTS = 100
   117	# How often one file is read again: a temporary read while it was being written, or a read that
   118	# failed for a reason other than the file being gone. Past it the file is a failure, never a skip.
   119	REREADS = 5
