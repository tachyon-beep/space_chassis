   215	CHECKPOINT_EVERY = 50
   216	# A result ends in its receipt line; `tick` is the tick its cycle began at (the receipt is drawn
   217	# before the step), and that cycle's record row is the tick after it.
   218	RECEIPT = re.compile(r"^receipt: world=(\S+) seq=\d+ window=\S+ tick=(\d+) ", re.MULTILINE)
   219	RESUMED = re.compile(
