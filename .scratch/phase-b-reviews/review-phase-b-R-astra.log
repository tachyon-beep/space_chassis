   291	    def compose_command(self, *args: str) -> list[str]:
   292	        return [
   293	            "docker",
   294	            "compose",
   295	            "-p",
   296	            self.project,
   297	            "--env-file",
   298	            str(self.root / "smoke.env"),
   299	            "-f",
   300	            str(REPO / "docker-compose.yml"),
   301	            "-f",
   302	            str(self.root / "override.yml"),
   303	            *[argument for path in self.overrides for argument in ("-f", str(path))],
   304	            "--profile",
   305	            "fleet",
   306	            "--profile",
   307	            self.window,
   308	            *args,
   309	        ]
   310	
   311	    def run(
   312	        self,
   313	        argv: list[str],
   314	        *,
   315	        check: bool = True,
   316	        stdin: str | None = None,
   317	        timeout: float = DOCKER_TIMEOUT_SECONDS,
   318	    ):
   319	        return self._runner(
   320	            argv,
   321	            cwd=str(REPO),
   322	            env=allowed_environment(),
   323	            input=stdin,
   324	            capture_output=True,
   325	            text=True,
   326	            check=check,
   327	            timeout=timeout,
   328	        )
