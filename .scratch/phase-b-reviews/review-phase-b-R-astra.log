   427	    def start(self) -> None:
   428	        self._hold_the_lock()
   429	        try:
   430	            self._refuse_beside_another()
   431	            self.prepare()
   432	            self.build()
   433	            # Again after the build: a stack started meanwhile by anything not holding the lock.
   434	            self._refuse_beside_another()
   435	            self.up()
   436	        except BaseException:
   437	            self.down()
   438	            raise
