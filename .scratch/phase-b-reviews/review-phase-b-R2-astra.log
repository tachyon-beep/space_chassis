   205	def _submit(stack, slug: str, command: str) -> None:
   206	    """As an agent submits: the whole file written aside, then renamed over console.json."""
   207	    console = stack.volumes / "diode" / "data" / slug / "console.json"
   208	    staging = console.with_name(".console.json.live.tmp")
   209	    staging.write_text(json.dumps({"commands": [command]}) + "\n", encoding="utf-8")
