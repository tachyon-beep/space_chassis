   100	def _files(window) -> set:
   101	    """Every regular file under a window now. A directory listed and gone before it is walked is
   102	    listed again, so a walk the vehicle races ends in a listing, never an error."""
   103	    for attempt in range(5):
   104	        try:
   105	            return {p for p in window.rglob("*") if p.is_file()}
   106	        except FileNotFoundError:
   107	            if attempt == 4:
   108	                raise
   109	            time.sleep(0.1)
   110	    raise AssertionError("unreachable")
   111	
   112	
   113	# How often a scan of one window lists it again after a file it listed is gone. A cycle every
   114	# 0.2 s removes a few names (the temporaries it renames into place, the telemetry it prunes); one
   115	# window's scan takes milliseconds, so a scan that needs more than this is not racing a cycle.
   116	RELISTS = 100
   117	# How often one file is read again: a temporary read while it was being written, or a read that
   118	# failed for a reason other than the file being gone. Past it the file is a failure, never a skip.
   119	REREADS = 5
   120	
   121	
   122	def _assert_no_window_carries_the_world_s_identity(stack) -> None:
   123	    """John, 2026-10-10: no risk of information sharing. The identity (scenario, seed, the armed
   124	    faults and their dwell) belongs in the window root's `.executive.json`, which no agent binds.
   125	    Every regular file in every agent's window is read: as text, for the smoke world's distinctive
   126	    seed; and as JSON where it is JSON, for the identity's keys and for the seed as a value.
   127	
   128	    The vehicle runs while this reads. It publishes by writing a randomly named temporary and
   129	    renaming it into place, and it prunes old telemetry, so a name listed a moment ago can be gone
   130	    for good: a read that finds it gone lists the window again and reads what is new, and what was
   131	    read is checked as read. `pending.json` must be read whole."""
   132	    executive = _executive(stack)
   133	    assert executive is not None and str(executive.get("seed")) == SMOKE_VEHICLE_SEED, executive
   134	    for slug in stack.slugs:
   135	        window = stack.volumes / "diode" / "data" / slug
   136	        checked: set = set()
   137	        todo = _files(window)
   138	        relists = 0
   139	        rereads: dict = {}
   140	        while todo:
   141	            path = min(todo)
   142	            where = path.relative_to(stack.volumes)
   143	            try:
   144	                text = path.read_text(encoding="utf-8", errors="replace")
   145	            except FileNotFoundError:
   146	                relists += 1
   147	                assert relists <= RELISTS, f"{slug}'s files kept vanishing: {relists} listings"
   148	                todo = _files(window) - checked
   149	                continue
   150	            except OSError as error:
   151	                rereads[path] = rereads.get(path, 0) + 1
   152	                assert rereads[path] < REREADS, f"{where} cannot be read after retries: {error}"
   153	                time.sleep(0.1)
   154	                continue
   155	            assert not SEED_TEXT.search(text), f"{where} carries the world's seed"
   156	            if path.suffix == ".json":
   157	                try:
   158	                    document = json.loads(text)
   159	                except ValueError:
   160	                    # Read again. A file that is malformed and then gone is dropped by the next
   161	                    # read, its text already scanned: the vehicle writes its JSON whole and renames
   162	                    # it into place, so only a file an agent wrote (console.json) can be torn.
   163	                    rereads[path] = rereads.get(path, 0) + 1
   164	                    assert rereads[path] < REREADS, f"{where} is not whole JSON after retries"
   165	                    time.sleep(0.1)
   166	                    continue
   167	                keys, values = _keys_and_values(document)
   168	                assert not keys & HIDDEN_KEYS, f"{where} carries {sorted(keys & HIDDEN_KEYS)}"
   169	                assert str(SMOKE_VEHICLE_SEED) not in {str(v) for v in values}, (
   170	                    f"{where} carries the seed"
   171	                )
   172	            checked.add(path)
   173	            todo.discard(path)
   174	        assert window / "pending.json" in checked, f"{slug}'s pending.json was never read whole"
