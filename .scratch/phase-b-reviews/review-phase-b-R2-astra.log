   584	class Leftover(Daemon):
   585	    """A daemon whose `docker rm -f` removes the sweep unless `stuck`, and whose listings of a
   586	    stack's containers (`ps -a -q`) answer from what is left."""
   587	
   588	    def __init__(self, sweep_ids="", stuck=False, listing_rc=0):
   589	        super().__init__(sweep_ids=sweep_ids)
   590	        self.stuck, self.listing_rc = stuck, listing_rc
   591	
   592	    def __call__(self, argv, **kwargs):
