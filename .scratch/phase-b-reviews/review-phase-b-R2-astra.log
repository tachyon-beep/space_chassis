    82	def _keys_and_values(value) -> tuple[set[str], list]:
    83	    if isinstance(value, dict):
    84	        keys, values = set(value), []
    85	        for item in value.values():
    86	            inner_keys, inner_values = _keys_and_values(item)
    87	            keys |= inner_keys
    88	            values += inner_values
    89	        return keys, values
    90	    if isinstance(value, list):
    91	        keys, values = set(), []
    92	        for item in value:
    93	            inner_keys, inner_values = _keys_and_values(item)
    94	            keys |= inner_keys
    95	            values += inner_values
    96	        return keys, values
    97	    return set(), [value]
