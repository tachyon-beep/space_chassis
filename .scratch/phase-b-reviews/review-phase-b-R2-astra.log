   213	# The smoke vehicle's cadence checkpoint: every tick that is a multiple of this.
   214	CHECKPOINT_EVERY = 50
   215	# A result ends in its receipt line; `tick` is the tick its cycle began at (the receipt is drawn
   216	# before the step), and that cycle's record row is the tick after it.
   217	RECEIPT = re.compile(r"^receipt: world=(\S+) seq=\d+ window=\S+ tick=(\d+) ", re.MULTILINE)
   218	RESUMED = re.compile(
   219	    r"resumed world (\S+) at tick (\d+) \(checkpoint \S+ at tick (\d+)(?:, fell back)?, replayed (\d+)"
   220	)
   221	# Setups tried before the test gives up: each is a fresh command and, unless the command's cycle
   222	# was already checkpointed before the kill, a kill and a resume.
   223	ATTEMPTS = 3
   224	
   225	
   226	def _receipt(stack, slug: str, name: str) -> tuple[str, int]:
   227	    """The world and the tick a result's receipt names. A result is written whole, never replaced."""
   228	    text = (stack.volumes / "diode" / "data" / slug / "output" / name).read_text(encoding="utf-8")
   229	    found = RECEIPT.findall(text)
   230	    assert found, f"{name} ends in no receipt: {text[-300:]!r}"
   231	    world, tick = found[-1]
   232	    return world, int(tick)
   233	
   234	
   235	def test_a_killed_console_resumes_the_same_world(vehicle_stack):
   236	    """One recorded command, run before the kill: the resume replays its cycle and must not run it
   237	    again, so it ends with exactly one result. An unknown verb is refused, and a refusal is a
   238	    result. (A batch replaced inside a claim can be erased, vehicle #39; then no result appears
   239	    here at all and this fails saying so.)
   240	
   241	    The command's cycle is proved to be one the resume replayed, from the result's receipt and the
   242	    resume's banner: its row (receipt tick T, plus one) lies after the checkpoint the resume began
   243	    from (tick M) and at or before the tick it recovered (N), so M <= T < N. A cadence checkpoint
   244	    that lands between the result and the kill would hold the command's cycle, and the replay would
   245	    then prove nothing about it: that setup is not counted, and the test sets up again."""
   246	    stack = vehicle_stack
   247	    slug = stack.slugs[0]
   248	    crossed = []
   249	    for _ in range(ATTEMPTS):
   250	        # Past the first cadence checkpoint and early in an interval, so the command's cycle and
   251	        # the kill after it normally both fall inside the ticks the resume must replay.
   252	        wait_for(
   253	            lambda: _tick(stack) >= 60 and 5 <= _tick(stack) % CHECKPOINT_EVERY <= 20,
   254	            timeout=START_SECONDS,
   255	            every=0.1,
   256	            what="a tick early in a checkpoint interval",
   257	        )
   258	        marker = f"live_resume_{time.time_ns()}"
   259	        _submit(stack, slug, f"{marker} probe")
   260	        names = wait_for(
   261	            lambda marker=marker: _results_for(stack, slug, marker),
   262	            timeout=30,
   263	            every=0.1,
   264	            what="a result for the submitted command (none: see vehicle #39 if this recurs)",
   265	        )
   266	        before = _executive(stack)
   267	        assert before is not None, "the window root's .executive.json cannot be read"
   268	        world, command_tick = _receipt(stack, slug, names[0])
   269	        assert world == before["world_id"], (world, before["world_id"])
   270	        # The first cadence checkpoint that holds the command's row (tick command_tick + 1).
   271	        holding = (command_tick // CHECKPOINT_EVERY + 1) * CHECKPOINT_EVERY
   272	        if before["tick"] >= holding:
   273	            crossed.append(f"tick {command_tick}: checkpoint {holding} before the kill")
   274	            continue
   275	        frames = {s: _newest_frame(stack, s) for s in stack.slugs}
   276	        assert all(frames.values()), frames
   277	        restarts = _restarts(stack)
   278	        banners = len(RESUMED.findall(stack.logs("vehicle")))
   279	        # docker-init is PID 1; the console is its child. `docker kill` would mark the container
   280	        # stopped by hand, and the restart policy would leave it down.
   281	        stack.exec("vehicle", "pkill", "-9", "-f", "[c]onsole\\.py")
   282	        wait_for(
   283	            lambda restarts=restarts: _restarts(stack) > restarts,
   284	            timeout=120,
   285	            every=1,
   286	            what="the restart policy to bring the vehicle back",
   287	        )
   288	
   289	        def resumed(frames=frames):
   290	            newest = {s: _newest_frame(stack, s) for s in stack.slugs}
   291	            fresh = all(
   292	                frame and frame.get("boot_id") != frames[s]["boot_id"]
   293	                for s, frame in newest.items()
   294	            )
   295	            return newest if fresh else None
   296	
   297	        after_frames = wait_for(
   298	            resumed,
   299	            timeout=START_SECONDS,
   300	            every=1,
   301	            what="a frame from the new boot in every window",
   302	        )
   303	        after = _executive(stack)
   304	        assert after is not None, "the window root's .executive.json cannot be read"
   305	        assert after["world_id"] == before["world_id"], "a restart resumes the world it was flying"
   306	        assert after["tick"] > before["tick"], (before["tick"], after["tick"])
   307	        for s in stack.slugs:
   308	            assert after_frames[s]["seq"] > frames[s]["seq"], f"{s}'s frame sequence continues"
   309	            assert _window_world(stack, s) == before["world_id"], s
   310	        found = RESUMED.findall(stack.logs("vehicle"))
   311	        assert len(found) == banners + 1, f"one resume banner for this boot: {found[banners:]}"
   312	        resumed_world, recovered, checkpoint, replayed = found[-1]
   313	        recovered, checkpoint, replayed = int(recovered), int(checkpoint), int(replayed)
   314	        assert resumed_world == before["world_id"], "the banner names the world it was flying"
   315	        assert replayed == recovered - checkpoint, "the banner's replay is its two ticks apart"
   316	        # A checkpoint that completed after the pre-kill read holds the command's cycle; the
   317	        # resume then replays nothing of it, possibly nothing at all. Set up again.
   318	        if checkpoint > command_tick:
   319	            crossed.append(f"tick {command_tick}: resumed from checkpoint {checkpoint}")
   320	            continue
   321	        # From here M <= T < N, so the resume replayed at least the command's cycle.
   322	        assert command_tick < recovered, (
   323	            f"the command's cycle (tick {command_tick}) is in the record the resume recovered "
   324	            f"(through tick {recovered})"
   325	        )
   326	        assert replayed > 0, "the resume replayed the ticks after its checkpoint"
   327	        results = _results_for(stack, slug, marker)
   328	        assert len(results) == 1, (
   329	            f"a recorded command has exactly one result after the replay: {results}"
   330	        )
   331	        _assert_no_window_carries_the_world_s_identity(stack)
   332	        return
   333	    raise AssertionError(f"no setup put the command's cycle inside the replay: {crossed}")
