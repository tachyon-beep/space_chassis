   532	class Daemon(Runner):
   533	    """A daemon with running containers: `projects` carry the compose project label, `sweeps` the
   534	    containment sweep's, and `sweep_ids` answer `docker ps -q` for this stack's sweeps."""
   535	
   536	    def __init__(self, projects="", sweeps="", sweep_ids="", fail_on=None):
   537	        super().__init__(fail_on)
   538	        self.projects, self.sweeps, self.sweep_ids = projects, sweeps, sweep_ids
   539	
   540	    def __call__(self, argv, **kwargs):
   541	        if argv[:2] == ["docker", "ps"]:
   542	            self.calls.append((argv, kwargs))
   543	            if "-q" in argv:
   544	                out = self.sweep_ids
   545	            elif "label=com.docker.compose.project" in argv:
   546	                out = self.projects
   547	            else:
   548	                out = self.sweeps
   549	            return subprocess.CompletedProcess(argv, 0, stdout=out, stderr="")
   550	        return super().__call__(argv, **kwargs)
