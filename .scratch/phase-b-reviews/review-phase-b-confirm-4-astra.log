+    def enforced_caps(self) -> dict[str, tuple[float, int, int]]:
+        """What the kernel enforces on each running service, read from its own cgroup (v2):
+        CPUs from `cpu.max`, and the memory and swap limits in bytes (-1 where unlimited)."""
+
+        def number(text: str) -> int:
+            return -1 if text == "max" else int(text)
+
+        caps = {}
+        for service in self.services():
+            read = self.exec(
+                service,
+                "cat",
+                "/sys/fs/cgroup/cpu.max",
+                "/sys/fs/cgroup/memory.max",
+                "/sys/fs/cgroup/memory.swap.max",
+            )
+            assert read.returncode == 0, f"{service}'s cgroup cannot be read: {read.stderr}"
+            cpu, memory, swap = read.stdout.split("\n")[:3]
+            quota, period = cpu.split()
+            cpus = -1.0 if quota == "max" else int(quota) / int(period)
+            caps[service] = (cpus, number(memory.strip()), number(swap.strip()))
+        return caps
+
