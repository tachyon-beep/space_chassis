   351	    def enforced_caps(self) -> dict[str, tuple[float, int, int]]:
   352	        """What the kernel enforces on each running service, read from its own cgroup (v2):
   353	        CPUs from `cpu.max`, and the memory and swap limits in bytes (-1 where unlimited)."""
   354	
   355	        def number(text: str) -> int:
   356	            return -1 if text == "max" else int(text)
   357	
   358	        caps = {}
   359	        for service in self.services():
   360	            read = self.exec(
   361	                service,
   362	                "cat",
   363	                "/sys/fs/cgroup/cpu.max",
   364	                "/sys/fs/cgroup/memory.max",
   365	                "/sys/fs/cgroup/memory.swap.max",
   366	            )
   367	            assert read.returncode == 0, f"{service}'s cgroup cannot be read: {read.stderr}"
   368	            cpu, memory, swap = read.stdout.split("\n")[:3]
   369	            quota, period = cpu.split()
   370	            cpus = -1.0 if quota == "max" else int(quota) / int(period)
   371	            caps[service] = (cpus, number(memory.strip()), number(swap.strip()))
   372	        return caps
