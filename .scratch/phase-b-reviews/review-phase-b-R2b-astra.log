   590	class Leftover(Daemon):
   591	    """A daemon whose `docker rm -f` removes the sweep unless `stuck`, and whose listings of a
   592	    stack's containers (`ps -a -q`) answer from what is left."""
   593	
   594	    def __init__(self, sweep_ids="", stuck=False, listing_rc=0):
   595	        super().__init__(sweep_ids=sweep_ids)
   596	        self.stuck, self.listing_rc = stuck, listing_rc
   597	
   598	    def __call__(self, argv, **kwargs):
   599	        if argv[:3] == ["docker", "rm", "-f"]:
   600	            self.calls.append((argv, kwargs))
   601	            if not self.stuck:
   602	                self.sweep_ids = ""
   603	            return subprocess.CompletedProcess(argv, 0, stdout="", stderr="")
   604	        if argv[:4] == ["docker", "ps", "-a", "-q"]:
   605	            self.calls.append((argv, kwargs))
   606	            out = self.sweep_ids if stack_module.SWEEP_LABEL in argv[-1] else ""
   607	            return subprocess.CompletedProcess(argv, self.listing_rc, stdout=out, stderr="")
   608	        return super().__call__(argv, **kwargs)
   609	
