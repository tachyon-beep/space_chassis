    20	start() prepares, builds and brings the stack up, and tears it down if any of that fails. down()
    21	is idempotent and also registered with atexit, and it marks itself done only once compose has
    22	returned, so a teardown interrupted by a second Ctrl-C is retried at exit. Every docker call has a
    23	timeout, so a wedged daemon fails a test instead of hanging the suite.
    24	"""
    25	
    26	from __future__ import annotations
    27	
    28	import atexit
    29	import contextlib
    30	import fcntl
    31	import json
    32	import os
    33	import shutil
    34	import signal
    35	import subprocess
    36	import sys
    37	import time
    38	from pathlib import Path
    39	
    40	REPO = Path(__file__).resolve().parent.parent
    41	sys.path.insert(0, str(REPO / "scripts"))
    42	
    43	import volume_images  # noqa: E402
    44	
    45	ALLOWED_VARIABLES = ("PATH", "HOME", "USER", "LANG", "XDG_RUNTIME_DIR")
    46	SMOKE_IMAGE = "space-chassis-agent:smoke"
    47	# The vehicle's own image (Dockerfile.agent's `vehicle` stage): the agents' carries nothing of it.
    48	SMOKE_VEHICLE_IMAGE = "space-chassis-vehicle:smoke"
    49	DECLARED_AGENTS = 10
    50	CONSOLE_SEED = REPO / "llm_console_seed.json"
    51	DOCKER_TIMEOUT_SECONDS = 120
    52	BUILD_TIMEOUT_SECONDS = 3600
    53	STUB_PORT = 8199
    54	DUMMY_KEY = "sk-smoke-dummy"
    55	# The window's two implementations: the contract fixture, or the vehicle itself.
    56	WINDOWS = ("diode", "vehicle")
    57	# The vehicle checkpoints every 50 ticks; at the operator's 5 s poll that is minutes per check.
    58	VEHICLE_SMOKE_POLL = "0.2"
    59	# A seed no window has any reason to contain, so live/test_vehicle.py can look for it in every file
    60	# an agent can read: the world's identity belongs in the window root's .executive.json alone.
    61	SMOKE_VEHICLE_SEED = "8675309"
    62	
    63	# The live run's budget (Governance, 2026-10-11): one smoke stack at a time, inside 5 CPUs and
    64	# 14 GiB in all, overhead included. What is enforced, each by the kernel:
    65	# - every container the stack starts: `cpus`, and `mem_limit` with `memswap_limit` equal to it, so
    66	#   nothing swaps past it (tmpfs pages are charged to the container too). The sum is STACK_CPUS and
    67	#   STACK_MEMORY; tests/test_live_stack.py holds the rendered config to it, and live/conftest.py
    68	#   reads every running container's cgroup back before a test runs;
    69	# - the containment check's throwaway image sweep (scripts/verify_containment.sh), one at a time
    70	#   beside the stack: SWEEP_CPUS and SWEEP_MEMORY;
    71	# - pytest and the docker clients: the user scope the run must be inside (HOST_CPUS, HOST_MEMORY;
    72	#   live/conftest.py refuses to start a stack outside one).
    73	# What is left (BUDGET minus those) is a reserve for the docker daemon's own work, which no client
    74	# can cap: it is not enforced. Agents keep the operator's 3g; their CPU is 0.75.
    75	CAPS = {
    76	    "agent": ("0.75", "3g"),
    77	    "recorder": ("0.2", "512m"),
    78	    "window": ("1.0", "512m"),
    79	    "stub": ("0.2", "256m"),
    80	    "fleet_monitor": ("0.1", "256m"),
    81	    "review": ("0.25", "512m"),
    82	}
    83	STACK_CPUS = 4.4
    84	STACK_MEMORY = 12 << 30
    85	SWEEP_CPUS, SWEEP_MEMORY = "0.2", "256m"
    86	HOST_CPUS = 0.35
    87	HOST_MEMORY = 1 << 30
    88	BUDGET_CPUS = 5.0
    89	BUDGET_MEMORY = 14 << 30
    90	HOST_SCOPE_COMMAND = "systemd-run --user --scope -p CPUQuota=35% -p MemoryMax=1G -p MemorySwapMax=0 nice -n 19 python3 -m pytest live -q"
    91	# One stack at a time: a lock every checkout and session of this user shares, held from start() to
    92	# down(), at one place derived from the user alone (never the environment, so two sessions cannot
    93	# disagree on it); and a refusal to start beside any smoke project or containment sweep already
    94	# running on the daemon.
    95	SMOKE_PROJECT_PREFIX = "space_chassis_smoke_"
    96	SMOKE_LOCK = Path(f"/run/user/{os.getuid()}") / "space_chassis_smoke.lock"
    97	# scripts/verify_containment.sh labels its image sweep with this, valued SWEEP_LABEL: the stack's
    98	# project when a live test runs it, so the stack's down() can remove a sweep a timeout orphaned.
    99	SWEEP_LABEL = "space_chassis.sweep"
   100	# Where docker's systemd cgroup driver puts a container: system.slice/docker-<id>.scope.
   101	DOCKER_CGROUPS = Path("/sys/fs/cgroup/system.slice")
   102	
   103	
   104	def memory_bytes(text: str) -> int:
   105	    """A compose memory value as bytes: `512m`, `3g`."""
   106	    return int(text[:-1]) << {"m": 20, "g": 30}[text[-1]]
   107	
   108	
   109	def cgroup_limits(directory: Path) -> tuple[float, int, int | None]:
   110	    """A cgroup v2 directory's CPUs, memory and swap limits; -1 where unlimited, None where absent."""
   111	
   112	    def number(text: str) -> int:
   113	        return -1 if text.strip() == "max" else int(text)
   114	
   115	    quota, period = (directory / "cpu.max").read_text().split()
   116	    cpus = -1.0 if quota == "max" else int(quota) / int(period)
   117	    memory = number((directory / "memory.max").read_text())
   118	    swap_file = directory / "memory.swap.max"
   119	    swap = number(swap_file.read_text()) if swap_file.exists() else None
   120	    return cpus, memory, swap
   121	
   122	
   123	def own_cgroup() -> Path:
   124	    """This process's cgroup v2 directory (the `0::` line; a host without one has no v2 path)."""
   125	    for line in Path("/proc/self/cgroup").read_text().splitlines():
   126	        if line.startswith("0::"):
   127	            return Path("/sys/fs/cgroup" + line[3:])
   128	    raise RuntimeError("this process is in no cgroup v2 hierarchy")
   129	
   130	
   131	def effective_limits(
   132	    directory: Path, root: Path = Path("/sys/fs/cgroup")
   133	) -> tuple[float, int, int | None]:
   134	    """The tightest CPUs, memory and swap limits on a cgroup and its ancestors below `root`: the
   135	    kernel enforces each one on everything below it. -1 (swap: None) where nothing limits it."""
   136	    cpus, memory, swap = -1.0, -1, None
   137	    while directory != root and root in directory.parents:
   138	        if (directory / "cpu.max").exists() and (directory / "memory.max").exists():
   139	            here = cgroup_limits(directory)
   140	            cpus = here[0] if cpus < 0 else (min(cpus, here[0]) if here[0] >= 0 else cpus)
   141	            memory = here[1] if memory < 0 else (min(memory, here[1]) if here[1] >= 0 else memory)
   142	            if here[2] is not None and here[2] >= 0:
   143	                swap = here[2] if swap is None or swap < 0 else min(swap, here[2])
   144	        directory = directory.parent
   145	    return cpus, memory, swap
   146	
   147	
   148	def allowed_environment(extra: dict | None = None) -> dict:
   149	    """The process environment docker runs with: an allowlist, never the operator's whole shell."""
   150	    env = {
   151	        key: value
   152	        for key, value in os.environ.items()
   153	        if key in ALLOWED_VARIABLES or key.startswith("DOCKER_")
   154	    }
   155	    env.update(extra or {})
   156	    return env
   157	
   158	
   159	def _capped(kind: str) -> list[str]:
   160	    """A service's caps, as override lines: its CPUs, and its memory with no swap past it."""
   161	    cpus, memory = CAPS[kind]
   162	    return [f'    cpus: "{cpus}"', f"    mem_limit: {memory}", f"    memswap_limit: {memory}"]
   163	
   164	
   165	def run_group(argv: list[str], *, env: dict, cwd, timeout: float) -> subprocess.CompletedProcess:
   166	    """Run argv as the leader of its own process group, and kill the whole group -- every
   167	    descendant, a subshell waiting on a lock included -- when it times out or anything else
   168	    interrupts the wait, so nothing it started can act after the caller has moved on."""
   169	    process = subprocess.Popen(
   170	        argv,
   171	        cwd=cwd,
   172	        env=env,
   173	        stdout=subprocess.PIPE,
   174	        stderr=subprocess.PIPE,
   175	        text=True,
   176	        start_new_session=True,
   177	    )
   178	    try:
   179	        out, err = process.communicate(timeout=timeout)
   180	    except BaseException:
   181	        with contextlib.suppress(ProcessLookupError):
   182	            os.killpg(process.pid, signal.SIGKILL)
   183	        process.communicate()
   184	        raise
   185	    # The leader has exited; anything it left in its group goes with it.
   186	    with contextlib.suppress(ProcessLookupError):
   187	        os.killpg(process.pid, signal.SIGKILL)
   188	    return subprocess.CompletedProcess(argv, process.returncode, out, err)
   189	
   190	
   191	def wait_for(predicate, *, timeout: float, every: float = 1.0, what: str):
   192	    """Poll predicate until it returns something truthy; raise naming what was awaited."""
   193	    deadline = time.monotonic() + timeout
   194	    while True:
   195	        value = predicate()
   196	        if value:
   197	            return value
   198	        if time.monotonic() >= deadline:
   199	            raise TimeoutError(f"waited {timeout}s for {what}")
   200	        time.sleep(every)
   201	
   202	
   203	class SmokeStack:
   204	    def __init__(
   205	        self,
   206	        agents: int = 3,
   207	        recorder_overrides: dict[int, dict] | None = None,
   208	        root: Path | None = None,
   209	        runner=subprocess.run,
   210	        window: str = "diode",
   211	        lock: Path | None = None,
   212	    ) -> None:
   213	        if window not in WINDOWS:
   214	            raise ValueError(f"window must be one of {WINDOWS}, not {window!r}")
   215	        self.agents = agents
   216	        self.recorder_overrides = recorder_overrides or {}
   217	        self.window = window
   218	        # A vehicle stack is its own project and scratch root; it never runs beside the fixture's.
   219	        suffix = "" if window == "diode" else f"_{window}"
   220	        self.project = f"{SMOKE_PROJECT_PREFIX}{os.getpid()}{suffix}"
   221	        self.root = (
   222	            Path(root)
   223	            if root is not None
   224	            else REPO / f".smoke-{os.getpid()}{suffix.replace('_', '-')}"
   225	        )
   226	        self._runner = runner
   227	        self._torn_down = False
   228	        self.lock = Path(lock) if lock is not None else SMOKE_LOCK
   229	        self._lock_fd: int | None = None
   230	        # How long a teardown waits for a --rm removal in progress before calling it left behind.
   231	        self.settle_seconds = 10.0
   232	        # Override files added after `up` by recreate(), kept on every later compose call.
   233	        self.overrides: list[Path] = []
   234	        atexit.register(self.down)
   235	
   236	    @property
   237	    def slugs(self) -> list[str]:
   238	        return [f"agent_{n}" for n in range(1, self.agents + 1)]
   239	
   240	    @property
   241	    def volumes(self) -> Path:
   242	        return self.root / "volumes"
   243	
   244	    @property
   245	    def cues(self) -> Path:
   246	        return self.root / "cues"
   247	
   248	    # ---------------------------------------------------------------- files
   249	
   250	    def prepare(self) -> None:
   251	        for name in volume_images.names(self.slugs):
   252	            (self.volumes / name / "data").mkdir(parents=True, exist_ok=True)
   253	        for slug in self.slugs:
   254	            (self.volumes / "diode" / "data" / slug / "output").mkdir(parents=True, exist_ok=True)
   255	        # The monitor and the review panel bind every agent the compose file declares, under its
   256	        # default slug, and docker refuses a missing bind source: the absent agents' records are
   257	        # empty directories.
   258	        for n in range(self.agents + 1, DECLARED_AGENTS + 1):
   259	            for kind in ("transcripts", "telemetry"):
   260	                (self.volumes / f"{kind}_agent_{n}" / "data").mkdir(parents=True, exist_ok=True)
   261	        self.cues.mkdir(parents=True, exist_ok=True)
   262	        (self.root / "smoke.env").write_text(self.env_text(), encoding="utf-8")
   263	        (self.root / "override.yml").write_text(self.override_text(), encoding="utf-8")
   264	
   265	    def env_text(self) -> str:
   266	        return "".join(
   267	            f"{key}={value}\n"
   268	            for key, value in (
   269	                ("OPENROUTER_API_KEY", DUMMY_KEY),
   270	                ("LLM_BASE_URL", f"http://stub:{STUB_PORT}/v1"),
   271	                ("LLM_API_KEY", "sk-stub"),
   272	                ("SPACE_VOLUMES_DIR", str(self.volumes)),
   273	                ("FLEET_SLUGS", ",".join(self.slugs)),
   274	            )
   275	        )
   276	
   277	    def override_text(self) -> str:
   278	        lines = [
   279	            "services:",
   280	            "  stub:",
   281	            f"    image: {SMOKE_IMAGE}",
   282	            *_capped("stub"),
   283	            '    entrypoint: ["python", "/opt/live/stub_llm.py"]',
   284	            "    environment:",
   285	            f'      VERIFY_STUB_PORT: "{STUB_PORT}"',
   286	            "      STUB_CUE_DIR: /cues",
   287	            '      VERIFY_STUB_DELAY_SECONDS: "2.0"',
   288	            '      VERIFY_STUB_TURNS_PER_INCARNATION: "40"',
   289	            "    volumes:",
   290	            "      - ./live:/opt/live:ro",
   291	            f"      - {self.cues}:/cues",
   292	            "    networks: [modelnet]",
   293	            "    read_only: true",
   294	            "    cap_drop: [ALL]",
   295	            '    security_opt: ["no-new-privileges:true"]',
   296	        ]
   297	        for n in range(1, self.agents + 1):
   298	            lines += [f"  agent_{n}:", f"    image: {SMOKE_IMAGE}", *_capped("agent")]
   299	            lines += [f"  recorder_{n}:", f"    image: {SMOKE_IMAGE}", "    depends_on: [stub]"]
   300	            lines += _capped("recorder")
   301	            overrides = self.recorder_overrides.get(n)
   302	            if overrides:
   303	                lines.append("    environment:")
   304	                lines += [f'      {key}: "{value}"' for key, value in overrides.items()]
   305	        if self.window == "diode":
   306	            lines += [
   307	                "  diode:",
   308	                f"    image: {SMOKE_IMAGE}",
   309	                *_capped("window"),
   310	                '    entrypoint: ["python", "/opt/fake/fake_diode.py"]',
   311	                "    environment:",
   312	                f"      AGENT_SLUGS: {','.join(self.slugs)}",
   313	                "    volumes:",
   314	                "      - ./contract/fake_diode.py:/opt/fake/fake_diode.py:ro",
   315	            ]
   316	        else:
   317	            # The vehicle serves VEHICLE_SLUGS, which compose fills from smoke.env's FLEET_SLUGS.
   318	            lines += [
   319	                "  vehicle:",
   320	                f"    image: {SMOKE_VEHICLE_IMAGE}",
   321	                *_capped("window"),
   322	                "    environment:",
   323	                f'      DIODE_POLL_SECONDS: "{VEHICLE_SMOKE_POLL}"',
   324	                f'      VEHICLE_SEED: "{SMOKE_VEHICLE_SEED}"',
   325	            ]
   326	        lines += [
   327	            "  fleet_monitor:",
   328	            f"    image: {SMOKE_IMAGE}",
   329	            *_capped("fleet_monitor"),
   330	            "    environment:",
   331	            f"      AGENT_SLUGS: {','.join(self.slugs)}",
   332	            '      MONITOR_INTERVAL_SECONDS: "5"',
   333	            '      QUIET_SECONDS: "20"',
   334	            "  review:",
   335	            f"    image: {SMOKE_IMAGE}",
   336	            *_capped("review"),
   337	            "    ports: !reset []",
   338	            "    environment:",
   339	            f"      AGENT_SLUGS: {','.join(self.slugs)}",
   340	        ]
   341	        return "\n".join(lines) + "\n"
   342	
   343	    # ---------------------------------------------------------------- docker
   344	
   345	    def compose_command(self, *args: str) -> list[str]:
   346	        return [
   347	            "docker",
   348	            "compose",
   349	            "-p",
   350	            self.project,
   351	            "--env-file",
   352	            str(self.root / "smoke.env"),
   353	            "-f",
   354	            str(REPO / "docker-compose.yml"),
   355	            "-f",
   356	            str(self.root / "override.yml"),
   357	            *[argument for path in self.overrides for argument in ("-f", str(path))],
   358	            "--profile",
   359	            "fleet",
   360	            "--profile",
   361	            self.window,
   362	            *args,
   363	        ]
   364	
   365	    def run(
   366	        self,
   367	        argv: list[str],
   368	        *,
   369	        check: bool = True,
   370	        stdin: str | None = None,
   371	        timeout: float = DOCKER_TIMEOUT_SECONDS,
   372	    ):
   373	        return self._runner(
   374	            argv,
   375	            cwd=str(REPO),
   376	            env=allowed_environment(),
   377	            input=stdin,
   378	            capture_output=True,
   379	            text=True,
   380	            check=check,
   381	            timeout=timeout,
   382	        )
   383	
   384	    def compose(
   385	        self,
   386	        *args: str,
   387	        check: bool = True,
   388	        stdin: str | None = None,
   389	        timeout: float = DOCKER_TIMEOUT_SECONDS,
   390	    ):
   391	        return self.run(self.compose_command(*args), check=check, stdin=stdin, timeout=timeout)
   392	
   393	    def build(self) -> None:
   394	        kept = CONSOLE_SEED.read_bytes() if CONSOLE_SEED.exists() else None
   395	        try:
   396	            self.run(
   397	                [
   398	                    sys.executable,
   399	                    str(REPO / "scripts" / "build_console_seed.py"),
   400	                    "--source",
   401	                    ".env.example",
   402	                ]
   403	            )
   404	            # The vehicle is in its own profile and image: built only by name, and only when it
   405	            # serves. One build at a time (Governance, 2026-10-11): compose builds the services it
   406	            # is given in parallel, so each is its own call.
   407	            self.compose("build", "agent_1", timeout=BUILD_TIMEOUT_SECONDS)
   408	            if self.window == "vehicle":
   409	                self.compose("build", "vehicle", timeout=BUILD_TIMEOUT_SECONDS)
   410	        finally:
   411	            if kept is None:
   412	                CONSOLE_SEED.unlink(missing_ok=True)
   413	            else:
   414	                CONSOLE_SEED.write_bytes(kept)
   415	
   416	    def up(self) -> None:
   417	        self.compose("up", "-d", *self.services())
   418	
   419	    def recreate(self, service: str, environment: dict[str, str]) -> None:
   420	        """Recreate one running service alone, with its environment changed and nothing else."""
   421	        path = self.root / f"recreate-{service}.yml"
   422	        lines = ["services:", f"  {service}:", "    environment:"]
   423	        # JSON's string is a YAML double-quoted scalar; `$$` is compose's literal dollar.
   424	        lines += [
   425	            f"      {key}: {json.dumps(str(value).replace('$', '$$'))}"
   426	            for key, value in environment.items()
   427	        ]
   428	        path.write_text("\n".join(lines) + "\n", encoding="utf-8")
   429	        if path not in self.overrides:
   430	            self.overrides.append(path)
   431	        self.compose("up", "-d", "--force-recreate", "--no-deps", service)
   432	
   433	    def _labelled(self, label: str) -> list[str]:
   434	        """The value of `label` on every running container that carries it."""
   435	        template = f'{{{{.Label "{label}"}}}}'
   436	        result = self.run(["docker", "ps", "--filter", f"label={label}", "--format", template])
   437	        return [line.strip() for line in result.stdout.splitlines() if line.strip()]
   438	
   439	    def others_running(self) -> list[str]:
   440	        """Every other smoke project with a container up on this daemon, and every containment
   441	        sweep running, whoever started it."""
   442	        projects = {
   443	            p
   444	            for p in self._labelled("com.docker.compose.project")
   445	            if p.startswith(SMOKE_PROJECT_PREFIX) and p != self.project
   446	        }
   447	        sweeps = {f"a containment sweep ({owner})" for owner in self._labelled(SWEEP_LABEL)}
   448	        return sorted(projects | sweeps)
   449	
   450	    def containment_check(self) -> subprocess.CompletedProcess:
   451	        """scripts/verify_containment.sh against this stack, in its own process group: a timeout
   452	        kills every process it started, so no sweep can be launched after the test moves on."""
   453	        return run_group(
   454	            ["sh", str(REPO / "scripts" / "verify_containment.sh")],
   455	            env=self.containment_environment(),
   456	            cwd=REPO,
   457	            timeout=900,
   458	        )
   459	
   460	    def containment_environment(self) -> dict:
   461	        """What scripts/verify_containment.sh runs with against this stack."""
   462	        agents = " ".join(f"agent_{n}" for n in range(1, self.agents + 1))
   463	        return allowed_environment(
   464	            {
   465	                "COMPOSE": " ".join(self.compose_command()),
   466	                "AGENTS": agents,
   467	                "SWEEP_LABEL": self.project,
   468	            }
   469	        )
   470	
   471	    def services(self) -> list[str]:
   472	        services = ["stub"]
   473	        services += [f"recorder_{n}" for n in range(1, self.agents + 1)]
   474	        services += [f"agent_{n}" for n in range(1, self.agents + 1)]
   475	        return services + [self.window, "fleet_monitor", "review"]
   476	
   477	    def enforced_caps(self) -> dict[str, tuple[float, int, int | None]]:
   478	        """What the kernel enforces on each running service: its container's own cgroup (v2), read
   479	        from the host side, so nothing inside the container is trusted or needs to answer."""
   480	        caps = {}
   481	        for service in self.services():
   482	            short = self.container_id(service)
   483	            assert short, f"{service} has no container"
   484	            full = self.run(["docker", "inspect", "-f", "{{.Id}}", short]).stdout.strip()
   485	            scope = DOCKER_CGROUPS / f"docker-{full}.scope"
   486	            assert scope.is_dir(), f"{service}'s cgroup is not at {scope}"
   487	            caps[service] = cgroup_limits(scope)
   488	        return caps
   489	
   490	    def _hold_the_lock(self) -> None:
   491	        if not self.lock.parent.is_dir():
   492	            raise RuntimeError(
   493	                f"one smoke stack at a time: no per-user runtime directory {self.lock.parent} "
   494	                "to hold its lock in"
   495	            )
   496	        fd = os.open(self.lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
   497	        try:
   498	            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
   499	        except BlockingIOError:
   500	            os.close(fd)
   501	            raise RuntimeError(f"one smoke stack at a time: another holds {self.lock}") from None
   502	        self._lock_fd = fd
   503	
