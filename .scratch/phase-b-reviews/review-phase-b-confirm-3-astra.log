   212	# The smoke vehicle's cadence checkpoint: every tick that is a multiple of this.
   213	CHECKPOINT_EVERY = 50
   214	# A result ends in its receipt line; `tick` is the tick its cycle began at (the receipt is drawn
   215	# before the step), and that cycle's record row is the tick after it.
   216	RECEIPT = re.compile(r"^receipt: world=(\S+) seq=\d+ window=\S+ tick=(\d+) ", re.MULTILINE)
   217	RESUMED = re.compile(
   218	    r"resumed world (\S+) at tick (\d+) \(checkpoint \S+ at tick (\d+)(?:, fell back)?, replayed (\d+)"
   219	)
   220	# Setups tried before the test gives up: each is a fresh command and, unless the command's cycle
   221	# was already checkpointed before the kill, a kill and a resume.
   222	ATTEMPTS = 3
   223	
   224	
   225	def _receipt(stack, slug: str, name: str) -> tuple[str, int]:
   226	    """The world and the tick a result's receipt names. A result is written whole, never replaced."""
   227	    text = (stack.volumes / "diode" / "data" / slug / "output" / name).read_text(encoding="utf-8")
   228	    found = RECEIPT.findall(text)
   229	    assert found, f"{name} ends in no receipt: {text[-300:]!r}"
   230	    world, tick = found[-1]
   231	    return world, int(tick)
