   126	    seed; and as JSON where it is JSON, for the identity's keys and for the seed as a value.
   127	
   128	    The vehicle runs while this reads. It publishes by writing a randomly named temporary and
   129	    renaming it into place, and it prunes old telemetry, so a name listed a moment ago can be gone
   130	    for good: a read that finds it gone lists the window again and reads what is new, and what was
   131	    read is checked as read. `pending.json` must be read whole."""
   132	    executive = _executive(stack)
   133	    assert executive is not None and str(executive.get("seed")) == SMOKE_VEHICLE_SEED, executive
   134	    for slug in stack.slugs:
   135	        window = stack.volumes / "diode" / "data" / slug
   136	        checked: set = set()
   137	        todo = _files(window)
   138	        relists = 0
   139	        rereads: dict = {}
   140	        while todo:
   141	            path = min(todo)
   142	            where = path.relative_to(stack.volumes)
   143	            try:
   144	                text = path.read_text(encoding="utf-8", errors="replace")
   145	            except FileNotFoundError:
   146	                relists += 1
   147	                assert relists <= RELISTS, f"{slug}'s files kept vanishing: {relists} listings"
   148	                todo = _files(window) - checked
   149	                continue
   150	            except OSError:
   151	                rereads[path] = rereads.get(path, 0) + 1
   152	                if rereads[path] >= REREADS:
   153	                    raise
   154	                time.sleep(0.1)
   155	                continue
   156	            assert not SEED_TEXT.search(text), f"{where} carries the world's seed"
   157	            if path.suffix == ".json":
   158	                try:
   159	                    document = json.loads(text)
   160	                except ValueError:
   161	                    rereads[path] = rereads.get(path, 0) + 1
   162	                    assert rereads[path] < REREADS, f"{where} is not whole JSON after retries"
   163	                    time.sleep(0.1)
   164	                    continue
   165	                keys, values = _keys_and_values(document)
   166	                assert not keys & HIDDEN_KEYS, f"{where} carries {sorted(keys & HIDDEN_KEYS)}"
   167	                assert str(SMOKE_VEHICLE_SEED) not in {str(v) for v in values}, (
   168	                    f"{where} carries the seed"
   169	                )
   170	            checked.add(path)
   171	            todo.discard(path)
   172	        assert window / "pending.json" in checked, f"{slug}'s pending.json was never read whole"
