   234	def test_a_killed_console_resumes_the_same_world(vehicle_stack):
   235	    """One recorded command, run before the kill: the resume replays its cycle and must not run it
   236	    again, so it ends with exactly one result. An unknown verb is refused, and a refusal is a
   237	    result. (A batch replaced inside a claim can be erased, vehicle #39; then no result appears
   238	    here at all and this fails saying so.)
   239	
   240	    The command's cycle is proved to be one the resume replayed, from the result's receipt and the
   241	    resume's banner: its row (receipt tick T, plus one) lies after the checkpoint the resume began
   242	    from (tick M) and at or before the tick it recovered (N), so M <= T < N. A cadence checkpoint
   243	    that lands between the result and the kill would hold the command's cycle, and the replay would
   244	    then prove nothing about it: that setup is not counted, and the test sets up again."""
   245	    stack = vehicle_stack
   246	    slug = stack.slugs[0]
   247	    crossed = []
   248	    for _ in range(ATTEMPTS):
   249	        # Past the first cadence checkpoint and early in an interval, so the command's cycle and
   250	        # the kill after it normally both fall inside the ticks the resume must replay.
   251	        wait_for(
   252	            lambda: _tick(stack) >= 60 and 5 <= _tick(stack) % CHECKPOINT_EVERY <= 20,
   253	            timeout=START_SECONDS,
   254	            every=0.1,
   255	            what="a tick early in a checkpoint interval",
   256	        )
   257	        marker = f"live_resume_{time.time_ns()}"
   258	        _submit(stack, slug, f"{marker} probe")
   259	        names = wait_for(
   260	            lambda marker=marker: _results_for(stack, slug, marker),
   261	            timeout=30,
   262	            every=0.1,
   263	            what="a result for the submitted command (none: see vehicle #39 if this recurs)",
   264	        )
   265	        before = _executive(stack)
   266	        world, command_tick = _receipt(stack, slug, names[0])
   267	        assert world == before["world_id"], (world, before["world_id"])
   268	        # The first cadence checkpoint that holds the command's row (tick command_tick + 1).
   269	        holding = (command_tick // CHECKPOINT_EVERY + 1) * CHECKPOINT_EVERY
   270	        if before["tick"] >= holding:
   271	            crossed.append(f"tick {command_tick}: checkpoint {holding} before the kill")
   272	            continue
   273	        frames = {s: _newest_frame(stack, s) for s in stack.slugs}
   274	        assert all(frames.values()), frames
   275	        restarts = _restarts(stack)
   276	        banners = len(RESUMED.findall(stack.logs("vehicle")))
   277	        # docker-init is PID 1; the console is its child. `docker kill` would mark the container
   278	        # stopped by hand, and the restart policy would leave it down.
   279	        stack.exec("vehicle", "pkill", "-9", "-f", "[c]onsole\\.py")
   280	        wait_for(
   281	            lambda restarts=restarts: _restarts(stack) > restarts,
   282	            timeout=120,
   283	            every=1,
   284	            what="the restart policy to bring the vehicle back",
   285	        )
   286	
   287	        def resumed(frames=frames):
   288	            newest = {s: _newest_frame(stack, s) for s in stack.slugs}
   289	            fresh = all(
   290	                frame and frame.get("boot_id") != frames[s]["boot_id"]
   291	                for s, frame in newest.items()
   292	            )
   293	            return newest if fresh else None
   294	
   295	        after_frames = wait_for(
   296	            resumed,
   297	            timeout=START_SECONDS,
   298	            every=1,
   299	            what="a frame from the new boot in every window",
   300	        )
   301	        after = _executive(stack)
   302	        assert after["world_id"] == before["world_id"], "a restart resumes the world it was flying"
   303	        assert after["tick"] > before["tick"], (before["tick"], after["tick"])
   304	        for s in stack.slugs:
   305	            assert after_frames[s]["seq"] > frames[s]["seq"], f"{s}'s frame sequence continues"
   306	            assert _window_world(stack, s) == before["world_id"], s
   307	        found = RESUMED.findall(stack.logs("vehicle"))
   308	        assert len(found) == banners + 1, f"one resume banner for this boot: {found[banners:]}"
   309	        resumed_world, recovered, checkpoint, replayed = found[-1]
   310	        recovered, checkpoint, replayed = int(recovered), int(checkpoint), int(replayed)
   311	        assert resumed_world == before["world_id"], "the banner names the world it was flying"
   312	        assert replayed == recovered - checkpoint > 0, (
   313	            "the resume replayed the ticks after its checkpoint"
   314	        )
   315	        if checkpoint > command_tick:
   316	            crossed.append(f"tick {command_tick}: resumed from checkpoint {checkpoint}")
   317	            continue
   318	        assert command_tick < recovered, (
   319	            f"the command's cycle (tick {command_tick}) is in the record the resume recovered "
   320	            f"(through tick {recovered})"
   321	        )
   322	        results = _results_for(stack, slug, marker)
   323	        assert len(results) == 1, (
   324	            f"a recorded command has exactly one result after the replay: {results}"
   325	        )
   326	        _assert_no_window_carries_the_world_s_identity(stack)
   327	        return
   328	    raise AssertionError(f"no setup put the command's cycle inside the replay: {crossed}")
