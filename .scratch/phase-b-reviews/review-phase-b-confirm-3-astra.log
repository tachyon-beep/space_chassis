   203	
   204	def _submit(stack, slug: str, command: str) -> None:
   205	    """As an agent submits: the whole file written aside, then renamed over console.json."""
   206	    console = stack.volumes / "diode" / "data" / slug / "console.json"
   207	    staging = console.with_name(".console.json.live.tmp")
   208	    staging.write_text(json.dumps({"commands": [command]}) + "\n", encoding="utf-8")
   209	    staging.replace(console)
