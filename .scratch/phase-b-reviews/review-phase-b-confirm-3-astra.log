  2696	def reconcile_root_record(
  2697	    record: dict[str, Any] | None, problem: str | None, expected: dict[str, Any]
  2698	) -> tuple[str, str]:
  2699	    """What to do about the root record beside a verified checkpoint: `("agree" | "rewrite" | "refuse", why)`.
  2700	
  2701	    `record` and `problem` are `read_root_record`'s answer; `expected` is `root_record_from_checkpoint`.
  2702	    A record that cannot be read, is missing, or disagrees with the checkpoint on any identity key is
  2703	    *rewritten* — never a refusal, because the root is agent-writable until the chassis adopts its
  2704	    per-slug mounts (`adf38d6`, chassis branch `aurora-port`) and a refusal there is a stop button in
  2705	    the agents' hands (ADR 0002 H). An unbound record (`world_id: null`) is a
  2706	    disagreement: the checkpoint is a world that exists. A *readable* record naming a different world
  2707	    is the one refusal: two executives with separate state directories on one diode directory.
  2708	    """
  2709	    if problem is not None:
  2710	        return "rewrite", f"the root record cannot be read ({problem}), so it is rewritten from the checkpoint"
  2711	    if record is None:
  2712	        return "rewrite", "there is no root record beside the checkpoint, so it is written from it"
  2713	    bound = record.get("world_id")
  2714	    if isinstance(bound, str) and bound and bound != expected["world_id"]:
  2715	        return "refuse", (
  2716	            f"the root record names world {bounded_repr(bound)} and the checkpoint records {expected['world_id']!r}: "
  2717	            "two executives with separate state directories on one diode directory (ADR 0002 H)"
  2718	        )
  2719	    differing = [key for key in ROOT_RECORD_IDENTITY if record.get(key) != expected[key]]
  2720	    if differing:
  2721	        return "rewrite", f"the root record disagrees with the checkpoint on {differing}, so it is rewritten from it"
  2722	    return "agree", "the root record is the checkpoint's copy"
