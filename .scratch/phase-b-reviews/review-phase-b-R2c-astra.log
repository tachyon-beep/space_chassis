   685	def _ended(pidfile, seconds: float = 5.0) -> bool:
   686	    """The process whose pid the child wrote is gone (or a zombie), within a bound."""
   687	    pid = int(pidfile.read_text())
   688	    deadline = time.monotonic() + seconds
   689	    while time.monotonic() < deadline:
   690	        try:
   691	            state = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0]
   692	        except OSError:
   693	            return True
   694	        if state == "Z":
   695	            return True
   696	        time.sleep(0.05)
   697	    return False
   698	
   699	
   700	def _child(tmp_path) -> tuple[str, Path, Path, Path]:
   701	    """A background child that says it started (its pid), then acts two seconds later; it
   702	    keeps the group's stdout and stderr open, as a real straggler would."""
   703	    ready, pidfile, late = tmp_path / "ready", tmp_path / "pid", tmp_path / "late"
   704	    child = f"sh -c 'echo $$ > {pidfile}; touch {ready}; sleep 2; touch {late}' &"
   705	    return child, ready, pidfile, late
   706	
