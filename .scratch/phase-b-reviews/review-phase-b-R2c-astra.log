   708	def test_a_timed_out_group_leaves_nothing_behind_that_can_act_later(tmp_path):
   709	    """The containment check's timeout must not leave a waiting subshell to launch a sweep after
   710	    the test has moved on: run_group kills the whole process group."""
   711	    child, ready, pidfile, late = _child(tmp_path)
   712	    script = f"{child} while [ ! -e {ready} ]; do sleep 0.05; done; sleep 30"
   713	    with pytest.raises(subprocess.TimeoutExpired):
   714	        stack_module.run_group(["sh", "-c", script], env=dict(os.environ), cwd=tmp_path, timeout=1)
   715	    assert ready.exists(), "the child never started, so this proves nothing"
   716	    assert _ended(pidfile), "the child outlived the timeout"
   717	    time.sleep(2.5)
   718	    assert not late.exists(), "a descendant outlived the timeout and acted"
   719	
   720	
   721	def test_a_finished_group_s_stragglers_are_killed_too(tmp_path):
   722	    """The leader exits while a child still holds its output open: the group is killed at the
   723	    leader's exit, not after the child has finished."""
   724	    child, ready, pidfile, late = _child(tmp_path)
   725	    script = f"{child} while [ ! -e {ready} ]; do sleep 0.05; done; echo started"
   726	    began = time.monotonic()
   727	    result = stack_module.run_group(
   728	        ["sh", "-c", script], env=dict(os.environ), cwd=tmp_path, timeout=10
   729	    )
   730	    assert time.monotonic() - began < 1.5, "the wait outlasted the leader"
   731	    assert result.returncode == 0 and result.stdout.strip() == "started"
   732	    assert _ended(pidfile), "the straggler outlived its leader"
   733	    time.sleep(2.5)
   734	    assert not late.exists(), "a straggler outlived its leader and acted"
