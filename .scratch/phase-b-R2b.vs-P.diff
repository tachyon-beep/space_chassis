+def run_group(argv: list[str], *, env: dict, cwd, timeout: float) -> subprocess.CompletedProcess:
+    """Run argv as the leader of its own process group, and kill the whole group -- every
+    descendant, a subshell waiting on a lock included -- when it times out or anything else
+    interrupts the wait, so nothing it started can act after the caller has moved on."""
+    process = subprocess.Popen(
+        argv,
+        cwd=cwd,
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        start_new_session=True,
+    )
+    try:
+        out, err = process.communicate(timeout=timeout)
+    except BaseException:
+        with contextlib.suppress(ProcessLookupError):
+            os.killpg(process.pid, signal.SIGKILL)
+        process.communicate()
+        raise
+    # The leader has exited; anything it left in its group goes with it.
+    with contextlib.suppress(ProcessLookupError):
+        os.killpg(process.pid, signal.SIGKILL)
+    return subprocess.CompletedProcess(argv, process.returncode, out, err)
