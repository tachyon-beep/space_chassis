  4218	            output = opened(self.output, root)
  4219	            telemetry = opened(self.telemetry, root)
  4220	            for name in self.FILES:
  4221	                try:
  4222	                    info = os.lstat(name, dir_fd=root)
  4223	                except FileNotFoundError:
  4224	                    continue
