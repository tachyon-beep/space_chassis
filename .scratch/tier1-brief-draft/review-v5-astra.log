  4306	    # -- the claim --------------------------------------------------------------------------
  4307	    def claim(self) -> list[Any] | str:
  4308	        """Read the console and clear it, *before* acting on anything.
  4309	
  4310	        The contract is unambiguous about the order: "**Intake is destructive and atomic.** Each
  4311	        cycle the vehicle reads the file, then rewrites it with `commands` emptied and `variables`
  4312	        preserved... **Clear before you act.**" So the rewrite happens here and the commands are
  4313	        returned for the executive to validate afterwards. A console that is not one — absent, a
  4314	        link, not a regular file, oversized, invalid, not an object — is *also* claimed, with the
  4315	        previous variables, and the reason is returned instead of a batch for the one refusal result
  4316	        (ADR 0001).
  4317	
  4318	        **Preserved verbatim; honoured separately.** `variables` is "persistent — the vehicle never
  4319	        clears it": the object the agent wrote becomes the preserved map as written (replace, not
  4320	        merge; a payload without a `variables` object keeps the previous map), and it is bounded by
  4321	        construction because it came from a file of at most `MAX_READ_BYTES`. What the vehicle acts
  4322	        on is `honoured()`'s business, computed from the preserved map once per cycle, after the
  4323	        claim, and never raising on any JSON value.
  4324	
  4325	        **A console with nothing to claim is not rewritten (#39).** The rewrite is a read followed by
  4326	        an `os.replace`, and no rename can check that the file it replaces is the file it read: a batch
  4327	        the agent put in place between the two was renamed over, unread — no result, no record. The
  4328	        claim ran on every cycle, the ~20 a second with nothing in them included, and every erased
  4329	        batch the chassis's contract probe caught was a quiet cycle's. So a console that is an object
  4330	        whose `commands` is exactly `[]` and that already shows the map — its own `variables` object,
  4331	        which is adopted, or no `variables` key while the window has no map to show — is left as it
  4332	        is: nothing written, nothing erased. A console that is not one, that has no `commands` key,
  4333	        or that leaves out `variables` while the window knows a map, is rewritten as before, so the
  4334	        file always shows the preserved map. **Residual:** every rewrite that remains — of a console
  4335	        that held a batch, of one that is not a console, of a bare one while the window knows a map —
  4336	        still erases a file the agent put in place between its read and its rewrite; the contract
  4337	        says so (John, 2026-10-11, tier 1), and the take that closes it is the next package.
  4338	        """
  4339	        root = self._handles().root
  4340	        payload, problem = read_ingress(self.console, dir_fd=root)
  4341	        if payload is None:
  4342	            write_json_atomic(self.console, self.claimed_console(), dir_fd=root, durable=self.executive.journal is not None)
  4343	            return str(problem)
  4344	        commands = payload.get("commands")
  4345	        variables = payload.get("variables")
  4346	        # Decided before the map is adopted, and from `isinstance` alone, so no JSON value can make it
  4347	        # raise: an exception here would leave the window unclaimed every cycle.
  4348	        quiet = (
  4349	            isinstance(commands, list)
  4350	            and not commands
  4351	            and (isinstance(variables, dict) or ("variables" not in payload and not self.variables_known))
  4352	        )
  4353	        # Replace, not merge: the object the agent wrote *is* the preserved map. A file with no
  4354	        # `variables` object keeps the previous one, which is what "never clears it" means.
  4355	        if isinstance(variables, dict):
  4356	            self.variables = variables
  4357	            self.variables_known = True
  4358	            self._honoured = None
  4359	        if quiet:
  4360	            return []
  4361	        # A claim that takes a batch is made durable — the file and the directory — before the record
  4362	        # says it was answered: a crash must not bring the commands back to run twice (child 4's review
  4363	        # finding 6). An empty claim is a quiet cycle's and costs no `fsync`; without a record nothing
  4364	        # relies on the claim being durable, and nothing is `fsync`ed.
  4365	        write_json_atomic(
  4366	            self.console,
  4367	            self.claimed_console(),
  4368	            dir_fd=root,
  4369	            durable=commands not in (None, []) and self.executive.journal is not None,
  4370	        )
  4371	        if commands is None:
  4372	            return []
  4373	        if not isinstance(commands, list):
