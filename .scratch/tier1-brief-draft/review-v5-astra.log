  4198	        self.close_handles()
  4199	
  4200	        def opened(name: str, dir_fd: int) -> int:
  4201	            where = name if dir_fd == self.executive.diode_fd else f"{self.slug}/{name}"
  4202	            try:
  4203	                return open_directory(name, dir_fd=dir_fd)
  4204	            except FileNotFoundError as exc:
  4205	                raise WindowAbsent(
