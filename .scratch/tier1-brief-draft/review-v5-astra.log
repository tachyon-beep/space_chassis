  4375	                f"console.json's `commands` is a JSON {type(commands).__name__}, not a list, so "
  4376	                "there is no batch here to run"
  4377	            )
  4378	        return commands
  4379	
  4380	    def claimed_console(self) -> dict[str, Any]:
  4381	        """What the claim rewrites the console to: commands emptied, the preserved `variables` — when known.
  4382	
  4383	        A resumed window whose console could not be read has no map to preserve (ADR 0002 G keeps it
  4384	        out of the checkpoint); its claim leaves the `variables` key out rather than writing `{}`,
  4385	        which would read as "the vehicle cleared it", and the window honours the defaults until the
  4386	        agent writes a console that carries one. The mid-run claim is this same rule with a known map.
  4387	        """
  4388	        if not self.variables_known:
  4389	            return {"commands": []}
  4390	        return {"commands": [], "variables": self.variables}
  4391	
  4392	    def honoured(self) -> tuple[dict[str, bool], int]:
  4393	        """What the vehicle honours of the preserved map: the published gates, and the allowance.
  4394	
  4395	        **Preserved is not honoured.** The map is the agent's and is kept verbatim; what the vehicle
  4396	        acts on is computed from it here, every cycle, and nothing in it can raise: a name is a gate
  4397	        only where the registry publishes one by that (instantiated) name and its value is a bool —
  4398	        anything else is treated as absent, so the gate stays at its default; `allowance` is honoured
  4399	        only as a non-negative integer, clamped to the operator's ceiling (§9 check 8: a preference
  4400	        may lower, never raise) — anything else leaves the ceiling in force. `{"allowance": "lots"}`
  4401	        was a `ValueError` in every tick's publication before this split.
  4402	        """
  4403	        if self._honoured is not None:
  4404	            return self._honoured
  4405	        gates: dict[str, bool] = {}
  4406	        allowance = DEFAULT_ALLOWANCE
  4407	        for name, value in self.variables.items():
  4408	            key = str(name)
  4409	            if key == "allowance":
  4410	                if isinstance(value, int) and not isinstance(value, bool) and value >= 0:
  4411	                    allowance = min(value, DEFAULT_ALLOWANCE)
  4412	            elif key in self.executive.gate_names and isinstance(value, bool):
  4413	                gates[key] = value
  4414	        self._honoured = (gates, allowance)
  4415	        return self._honoured
  4416	
  4417	    @property
  4418	    def allowance(self) -> int:
  4419	        return self.honoured()[1]
  4420	
  4421	    def closed_gates(self) -> set[str]:
  4422	        return {name for name, value in self.honoured()[0].items() if not value}
  4423	
  4424	    def capability(self, *, closed: bool = True) -> list[dict[str, Any]]:
  4425	        """The capability snapshot as this window sees it: its own closed gates, the operator's trips.
  4426	
  4427	        With `closed=False` the window's gates are left out, for the per-command gate check: the
  4428	        snapshot closes a *verb* when any instantiation is closed, and a command is gated by its own.
  4429	        """
  4430	        return capability_snapshot(
  4431	            self.executive.world,
  4432	            phase=self.executive.phase,
  4433	            closed_gates=self.closed_gates() if closed else set(),
  4434	            tripped_interlocks=self.executive.tripped,
  4435	        )
