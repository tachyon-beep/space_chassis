  4211	                    f"{where}: {code} ({exc.strerror}); a window is a directory of regular files and "
  4212	                    "directories, and the vehicle follows no link an agent plants"
  4213	                ) from exc
  4214	
  4215	        root = opened(self.slug, self.executive.diode_fd)
  4216	        output = telemetry = None
