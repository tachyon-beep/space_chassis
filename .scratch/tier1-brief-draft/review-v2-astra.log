    78	def read_bounded(path: Path, limit: int = 2_000_000) -> str | None:
    79	    try:
    80	        with open(path, "rb") as handle:
    81	            data = handle.read(limit + 1)
    82	    except OSError:
    83	        return None
    84	    if len(data) > limit:
    85	        return None
    86	    return data.decode("utf-8", "ignore")
