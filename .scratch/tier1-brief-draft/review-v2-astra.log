   187	        self.slot = 0
   188	        self.notes: list[str] = []
   189	        self.root.mkdir(parents=True, exist_ok=True)
   190	        self.output.mkdir(parents=True, exist_ok=True)
   191	        if not self.console.exists():
   192	            write_atomic(
   193	                self.console,
   194	                json.dumps({"commands": ["help"], "variables": {}}, indent=2) + "\n",
   195	            )
   196	
   197	    # -- intake -------------------------------------------------------------
   198	    def consume(self) -> tuple[list[str], dict]:
   199	        """Read the console, then clear the batch. Clear first, run after.
   200	
   201	        That ordering is what makes a command at-most-once: a crash in the
   202	        middle of a batch loses the rest of it rather than replaying what was
   203	        already run. The rewrite is atomic, so a caller writing at the same
   204	        moment either sees its batch taken whole or finds it untouched.
   205	        """
   206	        raw = read_bounded(self.console)
   207	        commands: list[str] = []
   208	        variables: dict = {}
   209	        if raw:
   210	            try:
   211	                loaded = json.loads(raw)
   212	            except json.JSONDecodeError:
   213	                loaded = None
   214	            if isinstance(loaded, dict):
   215	                candidates = loaded.get("commands")
   216	                if isinstance(candidates, list):
   217	                    commands = candidates
   218	                if isinstance(loaded.get("variables"), dict):
   219	                    variables = loaded["variables"]
   220	        write_atomic(
   221	            self.console,
   222	            json.dumps({"commands": [], "variables": variables}, indent=2) + "\n",
   223	        )
   224	        return commands, variables
   225	
   226	    def variables(self) -> dict:
   227	        raw = read_bounded(self.console)
   228	        if not raw:
   229	            return {}
   230	        with contextlib.suppress(json.JSONDecodeError):
   231	            loaded = json.loads(raw)
   232	            if isinstance(loaded, dict) and isinstance(loaded.get("variables"), dict):
   233	                return loaded["variables"]
   234	        return {}
   235	
   236	    # -- publication --------------------------------------------------------
   237	    def publish(self, limit: int) -> None:
   238	        variables = self.variables()
   239	        open_verbs = [
   240	            name
   241	            for name, spec in COMMANDS.items()
   242	            if not spec.get("hidden") and spec["gate"](variables)
   243	        ]
   244	        help_lines = ["# What this window accepts", ""]
   245	        for name in open_verbs:
   246	            help_lines.append(f"- `{COMMANDS[name]['help']}`")
   247	        help_lines += [
   248	            "",
   249	            "## Gates",
   250	            "",
   251	            "Set these in `variables` in `console.json`. They may open a verb that",
   252	            "is not listed while closed, and they can never raise an allowance.",
   253	            "",
   254	        ]
   255	        for name in sorted({_gate_name(spec) for spec in COMMANDS.values() if _gate_name(spec)}):
   256	            help_lines.append(f"- `{name}`")
   257	        help_lines += [
   258	            "",
   259	            "## Allowance",
   260	            "",
   261	            f"The far side permits at most {HOURLY_MAX} command(s) per rolling hour "
   262	            "across everything, and never more than `variables.hourly_allowance` "
   263	            "when that is set lower.",
   264	        ]
   265	        state = {
   266	            "slug": self.slug,
   267	            "published_at": utc_iso(),
   268	            "available_commands": open_verbs,
   269	            "variables": variables,
   270	            "budget": self.budget(limit),
   271	            "output_count": len(list(self.output.glob("*"))),
   272	            "pending": len(self.pending),
   273	            "notes_recorded": len(self.notes),
   274	            "telemetry_frames": len(list(self.telemetry.glob("*.json"))),
   275	            "protocol": "docs/diode-contract.md",
   276	        }
   277	        write_atomic(self.help_path, "\n".join(help_lines) + "\n")
   278	        write_atomic(self.state_path, json.dumps(state, indent=2) + "\n")
   279	        self.publish_telemetry(state)
