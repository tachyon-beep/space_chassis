    66	def write_atomic(path: Path, text: str) -> None:
    67	    path.parent.mkdir(parents=True, exist_ok=True)
    68	    handle, tmp = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=str(path.parent))
    69	    try:
    70	        with os.fdopen(handle, "w", encoding="utf-8") as stream:
    71	            stream.write(text)
    72	        os.replace(tmp, path)
    73	    finally:
    74	        with contextlib.suppress(FileNotFoundError):
    75	            os.unlink(tmp)
