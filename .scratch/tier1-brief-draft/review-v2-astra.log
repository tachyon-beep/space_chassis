 22598	def test_what_counts_as_nothing_to_claim_is_decided_by_shape_alone_and_the_console_always_shows_the_map(tmp_path):
 22599	    """#39's quiet rule, shape by shape: skip only a console that already shows the preserved map.
 22600	
 22601	    `{"commands": [], "variables": {...}}` is quiet whatever the map holds — the agent's own file
 22602	    already shows the map it set, which is adopted (replace, not merge) and honoured, so writing it
 22603	    back would change nothing but the inode. `{"commands": []}` with no `variables` is quiet only
 22604	    while the window has no map to show; while it has one, the console is rewritten once to show it
 22605	    ("never clears it"), and is quiet after that. No `commands` key, a `variables` that is not an
 22606	    object, and anything that is not a console are rewritten as before. The rule reads only types,
 22607	    so no JSON value can make it raise.
 22608	    """
 22609	    console, _plant, world = console_tools()
 22610	    diode = tmp_path / "diode"
 22611	    executive = console.Executive(world, diode, phase="translunar_coast")
 22612	    window = executive.attach("alpha")
 22613	    alpha = diode / "alpha"
 22614	
 22615	    def inode() -> int:
 22616	        return os.stat(alpha / "console.json").st_ino
 22617	
 22618	    # An agent's map-only console: adopted and honoured, the agent's file left in place.
 22619	    submit(alpha, [], {"ack_alarm_enable": False, "probe_marker": True})
 22620	    written = inode()
 22621	    executive.cycle()
 22622	    assert inode() == written
 22623	    assert window.variables == {"ack_alarm_enable": False, "probe_marker": True} and window.variables_known
 22624	    assert json.loads((alpha / "state.json").read_text())["variables"]["ack_alarm_enable"] is False
 22625	    # No `variables` while the map is known: rewritten once to show it, then quiet.
 22626	    (alpha / "console.json").write_text(json.dumps({"commands": []}), encoding="utf-8")
 22627	    bare = inode()
 22628	    executive.cycle()
 22629	    shown = json.loads((alpha / "console.json").read_text())
 22630	    assert shown == {"commands": [], "variables": {"ack_alarm_enable": False, "probe_marker": True}}
 22631	    assert inode() != bare
 22632	    settled = inode()
 22633	    executive.cycle()
 22634	    assert inode() == settled
 22635	    # The same bare console while the window has no map (as after a resume that found none): quiet.
 22636	    window.variables, window.variables_known, window._honoured = {}, False, None
 22637	    (alpha / "console.json").write_text(json.dumps({"commands": []}), encoding="utf-8")
 22638	    bare = inode()
 22639	    executive.cycle()
 22640	    assert inode() == bare and json.loads((alpha / "console.json").read_text()) == {"commands": []}
 22641	    # Shapes that are not "nothing to claim": each is rewritten, and none raises.
 22642	    window.variables, window.variables_known, window._honoured = {"kept": 1}, True, None
 22643	    for shape in (
 22644	        {"variables": {"kept": 1}},
 22645	        {"commands": [], "variables": [1]},
 22646	        {"commands": [], "variables": None},
 22647	        {"commands": {}, "variables": {"kept": 1}},
 22648	        {"commands": False, "variables": {"kept": 1}},
 22649	    ):
 22650	        (alpha / "console.json").write_text(json.dumps(shape), encoding="utf-8")
 22651	        before = inode()
 22652	        executive.cycle()
 22653	        assert inode() != before, shape
 22654	        assert json.loads((alpha / "console.json").read_text()) == {"commands": [], "variables": {"kept": 1}}, shape
 22655	    assert executive.failure_count == 0, list(executive.failures)
