     1	#!/bin/sh
     2	# The vehicle's half of the window, as a service.
     3	#
     4	# `docs/deep_research/vehicle/tools/console.py` is the loop this container runs. It reads the vehicle
     5	# configuration baked at /opt/vehicle, writes the six files of the window into the per-agent diode
     6	# directory, and advances telemetry on its own -- which is the whole of what `contract/diode_probe.py`
     7	# checks, and the reason this service exists rather than the fleet being pointed at the fixture
     8	# (`contract/fake_diode.py`), which satisfies the contract and models nothing.
     9	#
    10	# What this script decides, and what it deliberately does not:
    11	#
    12	#   * **the diode directory is the one the fleet is already mounted on.** Each agent binds only its
    13	#     own `/diode/<slug>/` from the shared window image; this service binds the whole window, so
    14	#     every agent's window appears inside that agent's own mount. A vehicle serving into a
    15	#     directory nobody reads is a working implementation of nothing.
    16	#   * **the slug is one window's name in that directory.** The console serves one `<slug>` per
    17	#     process, so the fleet's windows are one process each.
    18	#   * **it does not initialise and exit.** `console.py --init` creates the directory and stops,
    19	#     which is useful for a probe run by hand and useless as a service: the window has to keep
    20	#     publishing, because "state.json is rewritten every cycle whether or not anything was
    21	#     submitted" is what makes the mirror a mirror.
    22	#   * **it does not fly.** Accepting a command and simulating its consequence are different claims
    23	#     (`console.py`'s own docstring), and the physics that would follow is `plant.md`'s.
    24	#
    25	# The operator sets four things through the environment, all of them with the defaults the compose
    26	# file uses:
    27	#
    28	#   DIODE_DIR      where the per-slug directories live          (/diode)
    29	#   VEHICLE_SLUGS  which windows to serve, comma-separated      (roster, else `vehicle`)
    30	#   VEHICLE_SCENARIO  the run's difficulty identity            (nominal)
    31	#   VEHICLE_SEED   the run's master seed for the fault streams  (0)
    32	#   DIODE_POLL_SECONDS  seconds between cycles                  (5)
    33	#   VEHICLE_RING_SLOTS  frames per window                       (300)
    34	#
    35	# `--scenario` is validated by the console against `mission.yaml#scenario_postures`, so a typo here
    36	# stops the service with a message that names the three postures rather than running a nominal
    37	# mission under a crisis label.
    38	set -eu
    39	
    40	: "${DIODE_DIR:=/diode}"
    41	: "${VEHICLE_DIR:=/opt/vehicle}"
    42	: "${VEHICLE_SCENARIO:=nominal}"
    43	: "${VEHICLE_SEED:=0}"
    44	: "${DIODE_POLL_SECONDS:=5}"
    45	: "${VEHICLE_RING_SLOTS:=300}"
    46	
    47	export DIODE_DIR VEHICLE_DIR VEHICLE_SCENARIO VEHICLE_SEED DIODE_POLL_SECONDS
    48	export VEHICLE_RING_SLOTS
    49	
    50	if [ ! -f "$VEHICLE_DIR/tools/console.py" ]; then
    51	    echo "the vehicle is not at $VEHICLE_DIR -- this image was built without it" >&2
    52	    exit 44
    53	fi
    54	
    55	# **Which slugs to serve, and why the answer is a roster rather than a name.**
    56	#
    57	# The console serves one `<slug>` per process, and the fleet's agents are each given their own:
    58	# `docker-compose.yml` binds agent *n* to `/diode/$FLEET_N_SLUG`, taken from the roster
    59	# `scripts/roster.py` draws. So a vehicle that published into one directory called `vehicle` would be
    60	# a working implementation of nothing -- the agents would be reading their own empty directories and
    61	# concluding the vehicle was silent, which is the failure mode this whole side exists to prevent.
    62	#
    63	# Three ways to say it, in the order they win:
    64	#
    65	#   VEHICLE_SLUGS   an explicit comma-separated list
    66	#   the roster      whatever `.env`'s `FLEET_N_SLUG` names, because that is what the agents were told
    67	#   `vehicle`       the reference window, for a stack with no fleet in it
    68	#
    69	# The roster is read from `/diode`'s own entries as well as from the environment: an agent directory
    70	# that exists is an agent that will look, and a name in the environment that has no directory is one
    71	# this service can create. Both are swept, so a fleet started before or after the vehicle is served
    72	# either way.
    73	if [ -n "${VEHICLE_SLUGS:-}" ]; then
    74	    SLUGS=$(printf '%s' "$VEHICLE_SLUGS" | tr ',' ' ')
    75	else
    76	    SLUGS=""
    77	    for name in "$DIODE_DIR"/*; do
    78	        [ -d "$name" ] || continue
    79	        SLUGS="$SLUGS $(basename "$name")"
    80	    done
    81	    # The roster's names, from the environment `docker-compose.yml` passes to every service.
    82	    for var in $(env | sed -n 's/^\(FLEET_[0-9][0-9]*_SLUG\)=.*/\1/p' | sort); do
    83	        eval "value=\${$var}"
    84	        [ -n "$value" ] && SLUGS="$SLUGS $value"
    85	    done
    86	    [ -n "$SLUGS" ] || SLUGS="vehicle"
    87	fi
    88	
    89	# Deduplicated, and `vehicle` is always served: it is the window a probe run by hand points at, and
    90	# it costs one process to keep it there.
    91	FINAL=""
    92	for slug in $SLUGS vehicle; do
    93	    case " $FINAL " in
    94	        *" $slug "*) continue ;;
    95	    esac
    96	    FINAL="$FINAL $slug"
    97	done
    98	
    99	echo "[vehicle] serving $FINAL into $DIODE_DIR" >&2
   100	
   101	# One console per slug, and the shell waits on all of them: a service that forked and returned would
   102	# be a service whose container exits while its workers keep running.
   103	PIDS=""
   104	for slug in $FINAL; do
   105	    # The window directory, created here rather than by the console: the console creates it too, but
   106	    # a service that fails on its first run because a mount point is absent has failed for a reason
   107	    # that has nothing to do with the vehicle.
   108	    mkdir -p "$DIODE_DIR/$slug"
   109	    python3 "$VEHICLE_DIR/tools/console.py" \
   110	        --dir "$VEHICLE_DIR" \
   111	        --diode-dir "$DIODE_DIR" \
   112	        --slug "$slug" \
   113	        --scenario "$VEHICLE_SCENARIO" \
   114	        --seed "$VEHICLE_SEED" \
   115	        --ring-slots "$VEHICLE_RING_SLOTS" \
   116	        --poll "$DIODE_POLL_SECONDS" \
   117	        --cycles 0 &
   118	    PIDS="$PIDS $!"
   119	done
   120	
   121	# `wait` with no arguments waits for every child. A signal to this process (docker stop) reaches the
   122	# children because they are in the same process group, and the trap makes the exit the shell's rather
   123	# than a child's.
   124	trap 'kill $PIDS 2>/dev/null || true' TERM INT
   125	wait
     1	#!/bin/sh
     2	# The vehicle's half of the window, as a service.
     3	#
     4	# `docs/deep_research/vehicle/tools/console.py` is the executive this container runs: one process
     5	# for every window, which reads the vehicle configuration baked at /opt/vehicle, writes the six
     6	# files of each window into the shared window image, keeps its own private state (checkpoints, the
     7	# lock, the durable per-cycle record) under /state, and resumes the same world after a restart. That
     8	# is the whole of what `contract/diode_probe.py` checks of a window, and the reason this service
     9	# exists rather than the fleet being pointed at the fixture (`contract/fake_diode.py`), which
    10	# satisfies the contract and models nothing.
    11	#
    12	# What this script decides, and what it deliberately does not:
    13	#
    14	#   * **the window root is the one the fleet is already mounted on.** Each agent binds only its own
    15	#     `/diode/<slug>/` from the shared window image; this service binds the whole image, so every
    16	#     agent's window appears inside that agent's own mount.
    17	#   * **one executive serves every window.** Every window commands the one world, and the executive
    18	#     takes an exclusive lock on its state directory, so a second process would refuse.
    19	#   * **the slug set is the world's identity.** The vehicle records it in its checkpoint, and a
    20	#     restart whose set differs refuses (exit 3). So it comes from VEHICLE_SLUGS alone -- the roster
    21	#     compose passes -- and never from a scan of the window root, where a stray directory would turn
    22	#     every restart into a crash loop. Order does not matter; duplicates are dropped.
    23	#   * **`vehicle` is served only when there is no roster.** It is the window a probe run by hand
    24	#     points at, in a stack with no fleet in it. Beside a fleet it would be a command authority on
    25	#     the one world that no agent holds, and a probe that submits commands through it would actuate
    26	#     the spacecraft the fleet is flying with nobody to attribute it to.
    27	#   * **no `--phase`.** A resume takes the phase from the checkpoint; naming one that disagrees
    28	#     refuses.
    29	#   * **it `exec`s the console**, so it is the container's process under docker-init and `docker
    30	#     stop`'s SIGTERM reaches it directly.
    31	#   * **it does not fly.** Accepting a command and simulating its consequence are different claims
    32	#     (`console.py`'s own docstring), and the physics that would follow is `plant.md`'s.
    33	#
    34	# The operator sets these through the environment, all with the defaults the compose file uses:
    35	#
    36	#   DIODE_DIR           the window root                                  (/diode)
    37	#   VEHICLE_STATE_DIR   the executive's private state                    (/state)
    38	#   VEHICLE_SLUGS       the windows to serve, comma-separated            (the roster, else `vehicle`)
    39	#   VEHICLE_SCENARIO    the run's difficulty identity                    (nominal)
    40	#   VEHICLE_SEED        the run's master seed for the fault streams      (0)
    41	#   DIODE_POLL_SECONDS  seconds between cycles                           (5)
    42	#   VEHICLE_RING_SLOTS  frames per window                                (300)
    43	#
    44	# The scenario, the seed, the ring and the slug set are the world's identity: a restart that names
    45	# any of them differently refuses rather than flying a different world under the same name.
    46	set -eu
    47	# No pathname expansion anywhere: a slug is a name, never a pattern, and a glob would be a scan of
    48	# the working directory -- the very thing the slug set must never come from.
    49	set -f
    50	
    51	: "${DIODE_DIR:=/diode}"
    52	: "${VEHICLE_DIR:=/opt/vehicle}"
    53	: "${VEHICLE_STATE_DIR:=/state}"
    54	: "${VEHICLE_SCENARIO:=nominal}"
    55	: "${VEHICLE_SEED:=0}"
    56	: "${DIODE_POLL_SECONDS:=5}"
    57	: "${VEHICLE_RING_SLOTS:=300}"
    58	
    59	if [ ! -f "$VEHICLE_DIR/tools/console.py" ]; then
    60	    echo "the vehicle is not at $VEHICLE_DIR -- this image was built without it" >&2
    61	    exit 44
    62	fi
    63	
    64	# The roster's names, in the order given, each once; `vehicle` only when there is no roster.
    65	SLUGS=""
    66	for slug in $(printf '%s' "${VEHICLE_SLUGS:-}" | tr ',' ' '); do
    67	    # The roster's own alphabet (scripts/roster.py): a name that is not one path component never
    68	    # reaches the vehicle.
    69	    case "$slug" in
    70	        [a-z]*) ;;
    71	        *) echo "VEHICLE_SLUGS names '$slug', which is not a roster slug" >&2; exit 2 ;;
    72	    esac
    73	    case "$slug" in
    74	        *[!a-z0-9_]*) echo "VEHICLE_SLUGS names '$slug', which is not a roster slug" >&2; exit 2 ;;
    75	    esac
    76	    if [ "${#slug}" -gt 32 ]; then
    77	        echo "VEHICLE_SLUGS names '$slug', which is not a roster slug" >&2
    78	        exit 2
    79	    fi
    80	    case " $SLUGS " in
    81	        *" $slug "*) continue ;;
    82	    esac
    83	    SLUGS="$SLUGS $slug"
    84	done
    85	[ -n "$SLUGS" ] || SLUGS=" vehicle"
    86	
    87	set -- \
    88	    --dir "$VEHICLE_DIR" \
    89	    --diode-dir "$DIODE_DIR" \
    90	    --state-dir "$VEHICLE_STATE_DIR" \
    91	    --scenario "$VEHICLE_SCENARIO" \
    92	    --seed "$VEHICLE_SEED" \
    93	    --ring-slots "$VEHICLE_RING_SLOTS" \
    94	    --poll "$DIODE_POLL_SECONDS" \
    95	    --cycles 0
    96	for slug in $SLUGS; do
    97	    # The window directory, created here rather than left to the console, so a missing mount point
    98	    # fails for a reason that names it.
    99	    mkdir -p "$DIODE_DIR/$slug"
   100	    set -- "$@" --slug "$slug"
   101	done
   102	
   103	echo "[vehicle] serving$SLUGS into $DIODE_DIR, state in $VEHICLE_STATE_DIR" >&2
   104	exec python3 "$VEHICLE_DIR/tools/console.py" "$@"

