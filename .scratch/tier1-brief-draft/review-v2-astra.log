 22658	def test_a_resume_after_quiet_cycles_left_the_agent_s_console_in_place_adopts_its_map(tmp_path):
 22659	    """#39 needs no change to a resume: a console the claim no longer rewrites still carries the map.
 22660	
 22661	    A quiet cycle leaves the agent's own map-only console in place rather than a copy of it; ADR 0002
 22662	    G keeps `variables` out of the checkpoint and reads them back from the console, so the resumed
 22663	    window must honour exactly the map that file carries, as it would have from the vehicle's copy.
 22664	    """
 22665	    checkpoint, console, _plant, world = checkpoint_tools()
 22666	    diode, state = tmp_path / "diode", tmp_path / "state"
 22667	    executive = console.Executive(world, diode, phase="translunar_coast", state_dir=state)
 22668	    executive.attach("alpha")
 22669	    submit(diode / "alpha", [], {"ack_alarm_enable": False})
 22670	    recorded_run(executive, diode, {}, 3, snapshot_at=3)
 22671	    left = os.stat(diode / "alpha" / "console.json").st_ino
 22672	    executive.close()
 22673	    resumed, _ = resume_from(console, checkpoint, world, diode, state)
 22674	    window = resumed.windows["alpha"]
 22675	    assert window.variables == {"ack_alarm_enable": False} and window.variables_known
 22676	    resumed.cycle()
 22677	    assert os.stat(diode / "alpha" / "console.json").st_ino == left
 22678	    assert json.loads((diode / "alpha" / "state.json").read_text())["variables"]["ack_alarm_enable"] is False
 22679	    resumed.close()
