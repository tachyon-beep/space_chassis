 22542	    """#39: the claim renamed its rewrite over a batch the agent put in place after the read, unread.
 22543	
 22544	    The claim was a read and then an `os.replace`, on every cycle, the ~20 a second with nothing in
 22545	    them included; a batch whose own `os.replace` landed between the two was renamed over — no
 22546	    result, no record — and every such loss the chassis's contract probe caught was a quiet cycle's.
 22547	    A console with nothing to claim is now left alone: across quiet cycles its inode and its mtime do
 22548	    not move, and a batch that lands while a quiet console is being read is still there afterwards
 22549	    and is claimed by the next cycle, one result per command — whether the agent writes it into the
 22550	    file the claim read (in place) or renames a new file over it (the contract's way, the probe's).
 22551	    """
 22552	    console, _plant, world = console_tools()
 22553	    diode = tmp_path / "diode"
 22554	    executive = console.Executive(world, diode, phase="translunar_coast")
 22555	    executive.attach("alpha")
 22556	    alpha = diode / "alpha"
 22557	    executive.cycle()
 22558	    before = os.stat(alpha / "console.json")
 22559	    for _ in range(3):
 22560	        executive.cycle()
 22561	    after = os.stat(alpha / "console.json")
 22562	    assert (after.st_ino, after.st_mtime_ns) == (before.st_ino, before.st_mtime_ns)
 22563	
 22564	    real_read = console.read_ingress
 22565	    batch = ["set_rcs_mode mode=manual", "zzz_not_a_verb"]
 22566	
 22567	    def in_place() -> None:
 22568	        submit(alpha, batch)
 22569	
 22570	    def renamed_over() -> None:
 22571	        incoming = alpha / ".agent.console.json.tmp"
 22572	        incoming.write_text(json.dumps({"commands": batch}), encoding="utf-8")
 22573	        os.replace(incoming, alpha / "console.json")
 22574	
 22575	    for land in (in_place, renamed_over):
 22576	        armed = [True]
 22577	
 22578	        def agent_lands_after_the_read(path, *, dir_fd=None, land=land, armed=armed):
 22579	            read = real_read(path, dir_fd=dir_fd)
 22580	            if armed[0] and path == "console.json":
 22581	                armed[0] = False
 22582	                land()
 22583	            return read
 22584	
 22585	        monkeypatch.setattr(console, "read_ingress", agent_lands_after_the_read)
 22586	        clear_results(alpha)
 22587	        executive.cycle()
 22588	        assert armed == [False], land.__name__
 22589	        assert json.loads((alpha / "console.json").read_text())["commands"] == batch, land.__name__
 22590	        assert results_of(alpha) == [], land.__name__
 22591	        executive.cycle()
 22592	        bodies = results_of(alpha)
 22593	        assert len(bodies) == 2, (land.__name__, bodies)
 22594	        assert json.loads((alpha / "console.json").read_text())["commands"] == [], land.__name__
 22595	    assert executive.failure_count == 0, list(executive.failures)
