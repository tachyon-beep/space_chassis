  3611	                        command,
  3612	                        "refused",
  3613	                        f"refused: EXPIRED. {verb!r} was accepted at tick {accepted_tick} and has "
  3614	                        f"waited {age:.1f} s of simulated time, past its own maximum_queue_age_s of "
  3615	                        f"{limit:g}. V-02 makes `EXPIRED` a refusal reached from REVALIDATING, so "
  3616	                        "the command is re-checked when it is due and it is *this* check that fires "
  3617	                        "first — a command whose intent has gone stale is declined rather than run "
  3618	                        "late.\n",
  3619	                        verb=verb,
