-        os.killpg(process.pid, signal.SIGKILL)
-    return subprocess.CompletedProcess(argv, process.returncode, out, err)
+    descendant, a subshell waiting on a lock included -- as soon as the leader exits, times out,
+    or anything else interrupts the wait, so nothing it started can act after the caller has
+    moved on. Output goes to files, not pipes: a straggler holding a pipe open would otherwise
+    keep the wait going until it had finished, and the kill would come after it acted."""
+    with tempfile.TemporaryFile("w+") as out, tempfile.TemporaryFile("w+") as err:
+        process = subprocess.Popen(
+            argv, cwd=cwd, env=env, stdout=out, stderr=err, text=True, start_new_session=True
+        )
+        try:
+            returncode = process.wait(timeout=timeout)
+        finally:
+            with contextlib.suppress(ProcessLookupError):
+                os.killpg(process.pid, signal.SIGKILL)
+            process.wait()
+        out.seek(0)
+        err.seek(0)
+        return subprocess.CompletedProcess(argv, returncode, out.read(), err.read())
 
 
