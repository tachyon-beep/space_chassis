# The constants of the world, installed at /etc/agent.env and exported by the
# entrypoint for every process in the agent container. Most of these are facts
# about where things are rather than settings. Overriding one here means an
# operator edited the image; nothing in the container can rewrite this file.

# --- paths -----------------------------------------------------------------
# The shared, durable codebase. Every agent in the fleet mounts this same
# volume, read-write. It survives restarts of everything.
WORK_DIR=/work
# This agent's home: its durable, private directory. Survives everything.
AGENT_HOME=/home/agent
# The image's pristine copy of the seed. Read-only, and the floor beneath any
# recovery the supervisor does.
SEED_DIR=/opt/agent
# The briefing. Read-only. The mission is here.
BRIEF_DIR=/opt/brief
# Operator-side services (recorder, supervisor, pump, fleet monitor), read-only.
SERVICES_DIR=/opt/services

# --- mounts ----------------------------------------------------------------
# The private, append-only record this agent writes to itself. Read-write.
DIARY_DIR=/diary
# Everyone's record: the transcript the recorder writes and the diary, mounted
# read-only. What they did is written here whether they like it or not.
TRANSCRIPTS_DIR=/transcripts
# The one window outward, and the only way anything enters the world.
DIODE_DIR=/diode
# Scheduled and supervised processes run from here.
PUMP_DIR=/pump
# The supervisor's mirror of /work and its lifecycle record. Read-only here.
TELEMETRY_DIR=/telemetry
# Offline crate registry for Rust resolves. Read-only.
VENDOR_DIR=/vendor

# --- the model -------------------------------------------------------------
# The recorder's unix socket, named per agent by the compose file. The only
# route out of this container to a model, and the only thing on it: a keyless
# chat-completions endpoint the recorder holds the credential for. A duty
# writing its own client needs a *path*, not a URL -- that is what makes the
# key's absence structural rather than a promise.
#LLM_SOCKET_PATH=/llm/sock/<slug>.sock    # set by the service, not here
# The scheme and host the SDK needs to build a URL it will never resolve.
LLM_BASE_URL=http://localhost/api/v1
LLM_MODEL=
# Carried in the environment as a shape only. The recorder replaces it.
OPENROUTER_API_KEY=sk-dummy

# --- the conversation window ----------------------------------------------
# Messages older than the window stop being sent, without notice, unless the
# duty makes its own arrangement. The chassis keeps a recap of what was
# dropped and keeps sending that.
CONTEXT_WINDOW_TOKENS=200000
CONTEXT_WINDOW_EVICTION_TOKENS=
# A run of the duty ends at either of these and the supervisor starts another.
# Unset means a run ends only when the duty ends it, or when it dies.
RUN_MAX_TURNS=
RUN_MAX_SECONDS=

# --- the bus and the database ---------------------------------------------
# Both servers exist and are running, and neither has been given any structure.
# One database, `chassis`; no schema. One bus with no subjects registered and
# no accounts beyond a default one. The integration layer is the mission's.
CHASSIS_DB_URL=postgresql://chassis@127.0.0.1:5432/chassis
CHASSIS_BUS_URL=nats://127.0.0.1:4222
